---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WalkCover from '@/components/walk/WalkCover.astro';
import PhotoGallery from '@/components/walk/PhotoGallery.astro';
import WalkMiniMap from '@/components/map/WalkMiniMap.astro';
import Badge from '@/components/ui/Badge.astro';
import { baseUrl } from '@/lib/utils/url';
import { formatDateKorean } from '@/lib/utils/date';
import type { MapPlace } from '@/lib/map/types';
import {
  Calendar,
  Clock,
  CloudSun,
  Users,
  MapPin,
  ChevronLeft,
  ChevronRight,
  ArrowLeft,
  ArrowRight,
  Tag,
  BookOpen,
} from '@lucide/astro';

export async function getStaticPaths() {
  const walks = await getCollection('walks', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  // 날짜 역순(최신순) 정렬
  walks.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return walks.map((walk, index) => {
    // walks가 내림차순 정렬되어 있으므로:
    // 이전 글(더 과거)은 index + 1
    // 다음 글(더 최신)은 index - 1
    const prevWalk = index + 1 < walks.length ? walks[index + 1] : null;
    const nextWalk = index - 1 >= 0 ? walks[index - 1] : null;

    return {
      params: { slug: walk.id },
      props: { walk, prevWalk, nextWalk },
    };
  });
}

const { walk, prevWalk, nextWalk } = Astro.props;
const {
  title,
  date,
  timeOfDay,
  weather,
  companions,
  mood,
  places,
  photoFolder,
  cover,
  captions,
  tags,
} = walk.data;

const resolvedPlaces = await getEntries(places);
const { Content } = await render(walk);

const coursePlaces: MapPlace[] = resolvedPlaces.map((place) => ({
  id: place.id,
  name: place.data.name,
  lat: place.data.lat,
  lng: place.data.lng,
  sido: place.data.sido,
  sigungu: place.data.sigungu,
  type: place.data.type,
  facilities: place.data.facilities,
  tips: place.data.tips,
  hidden: place.data.hidden,
}));
---

<BaseLayout title={title} description={`${formatDateKorean(date)} 산책 기록: ${title}`}>
  <div class="min-h-screen bg-[#F8F6F0] dark:bg-[#131211] py-8 sm:py-14">
    <article class="max-w-2xl mx-auto px-4 sm:px-6">
      <!-- 상단 뒤로가기 -->
      <div class="mb-8">
        <a
          href={baseUrl('/archive')}
          class="inline-flex items-center gap-1.5 text-xs font-serif font-medium text-stone-600 hover:text-stone-950 dark:text-stone-400 dark:hover:text-white transition-colors bg-white/80 dark:bg-stone-800/80 px-3.5 py-2 rounded-xl border border-stone-200 dark:border-stone-700 shadow-xs"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          열람 기록부로 돌아가기
        </a>
      </div>

    <!-- 서가/앨범 연계 안내 배너 -->
    {resolvedPlaces.length > 0 && (
      <div class="mb-8 p-3.5 sm:p-4 rounded-xl bg-paper-100 dark:bg-night-900 border border-paper-200 dark:border-night-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-serif">
        <div class="flex items-center gap-2">
          <BookOpen class="w-4 h-4 text-wood-600 dark:text-wood-400 shrink-0" />
          <span class="text-ink-700 dark:text-paper-300">
            이 기록은 <strong class="text-ink-900 dark:text-paper-100">{resolvedPlaces[0].data.name}</strong> 앨범에 한 장으로 수록되어 있습니다.
          </span>
        </div>
        <a
          href={baseUrl(`/places/${resolvedPlaces[0].id}#chapter-${walk.id}`)}
          class="shrink-0 font-semibold text-terracotta-600 dark:text-terracotta-300 hover:underline flex items-center gap-1"
        >
          <span>앨범 펼쳐보기</span>
          <ArrowRight class="w-3 h-3" />
        </a>
      </div>
    )}

    <!-- 헤더 영역 -->
    <header class="mb-10 text-center sm:text-left">
      <!-- 메타 칩 (날짜, 기분, 날씨, 시간대, 동행) -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-4 text-xs text-ink-600 dark:text-ink-400">
        <span class="inline-flex items-center gap-1 font-medium">
          <Calendar class="w-3.5 h-3.5 text-terracotta-500" />
          <time datetime={date}>{formatDateKorean(date)}</time>
        </span>

        {timeOfDay && (
          <span class="inline-flex items-center gap-1 text-ink-500">
            <Clock class="w-3.5 h-3.5" />
            {timeOfDay}
          </span>
        )}

        {weather && (
          <span class="inline-flex items-center gap-1 text-ink-500">
            <CloudSun class="w-3.5 h-3.5" />
            {weather}
          </span>
        )}

        {companions && (
          <span class="inline-flex items-center gap-1 text-ink-500">
            <Users class="w-3.5 h-3.5" />
            {companions}
          </span>
        )}

        {mood && <Badge variant="accent">{mood}</Badge>}
      </div>

      <!-- 제목 -->
      <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-ink-900 dark:text-paper-100 leading-snug sm:leading-tight mb-6">
        {title}
      </h1>

      <!-- 방문한 장소 태그 -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 pt-2 border-t border-paper-200 dark:border-night-800">
        <span class="text-xs text-ink-400 dark:text-ink-500 flex items-center gap-1">
          <MapPin class="w-3.5 h-3.5" />
          들른 곳:
        </span>
        {resolvedPlaces.map((place) => (
          <a
            href={baseUrl(`/places/${place.id}`)}
            class="inline-flex items-center gap-1 text-xs font-medium text-forest-700 dark:text-forest-100 bg-forest-50 dark:bg-night-800 px-2.5 py-1 rounded-md hover:bg-forest-100 dark:hover:bg-night-700 transition-colors"
          >
            <span>{place.data.name}</span>
            <span class="text-[10px] opacity-70">({place.data.sigungu})</span>
          </a>
        ))}
      </div>
    </header>

    <!-- 대표 이미지 커버 -->
    <div class="mb-10">
      <WalkCover photoFolder={photoFolder} date={date} cover={cover} places={places} title={title} aspect="wide" />
    </div>

    <!-- 본문 에세이 (산문집 감성 타이포그래피) -->
    <div class="prose prose-essay max-w-none text-ink-800 dark:text-paper-200 font-sans">
      <Content />
    </div>

    <!-- 사진 갤러리 (캡션 및 라이트박스 지원) -->
    <PhotoGallery photoFolder={photoFolder} date={date} cover={cover} places={places} captions={captions} title={title} />

    <!-- 산책 코스 인터랙티브 미니맵 (카카오맵 연동) -->
    <WalkMiniMap places={coursePlaces} route={walk.data.route} walkTitle={title} />

    <!-- 태그 목록 -->
    {tags && tags.length > 0 && (
      <div class="mt-8 pt-6 border-t border-paper-200 dark:border-night-800 flex flex-wrap items-center gap-2">
        <Tag class="w-3.5 h-3.5 text-ink-400" />
        {tags.map((tag) => (
          <a
            href={baseUrl(`/archive?tag=${encodeURIComponent(tag)}`)}
            class="text-xs text-ink-600 dark:text-ink-400 hover:text-terracotta-600 dark:hover:text-terracotta-100 bg-paper-200/60 dark:bg-night-800 px-2.5 py-1 rounded-full transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- 이전 글 / 다음 글 네비게이션 -->
    <nav class="mt-12 pt-8 border-t border-paper-200 dark:border-night-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevWalk ? (
        <a
          href={baseUrl(`/walks/${prevWalk.id}`)}
          class="group flex flex-col p-4 rounded-xl border border-paper-200 dark:border-night-800 hover:border-terracotta-200 dark:hover:border-terracotta-700/50 bg-white dark:bg-night-900/40 transition-all text-left"
        >
          <span class="inline-flex items-center text-xs text-ink-400 group-hover:text-terracotta-600 mb-1">
            <ChevronLeft class="w-3.5 h-3.5 mr-0.5" />
            이전 기록
          </span>
          <span class="font-serif text-sm font-bold text-ink-800 dark:text-paper-200 group-hover:text-terracotta-600 dark:group-hover:text-terracotta-100 line-clamp-1">
            {prevWalk.data.title}
          </span>
          <span class="text-[11px] text-ink-400 mt-1">
            {formatDateKorean(prevWalk.data.date)}
          </span>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}

      {nextWalk && (
        <a
          href={baseUrl(`/walks/${nextWalk.id}`)}
          class="group flex flex-col p-4 rounded-xl border border-paper-200 dark:border-night-800 hover:border-terracotta-200 dark:hover:border-terracotta-700/50 bg-white dark:bg-night-900/40 transition-all text-right sm:col-start-2"
        >
          <span class="inline-flex items-center justify-end text-xs text-ink-400 group-hover:text-terracotta-600 mb-1">
            다음 기록
            <ChevronRight class="w-3.5 h-3.5 ml-0.5" />
          </span>
          <span class="font-serif text-sm font-bold text-ink-800 dark:text-paper-200 group-hover:text-terracotta-600 dark:group-hover:text-terracotta-100 line-clamp-1">
            {nextWalk.data.title}
          </span>
          <span class="text-[11px] text-ink-400 mt-1">
            {formatDateKorean(nextWalk.data.date)}
          </span>
        </a>
      )}
    </nav>
  </article>
</div>
</BaseLayout>
