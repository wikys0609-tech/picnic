<script>
  import { verifyGithubToken, atomicCommitFiles } from '@/lib/github/github-api';
  import { normalizeDistrict, findNearbyPlaces } from '@/lib/geo/districts';
  import { generatePlaceMarkdown, generateWalkMarkdown, type PlaceInput, type WalkInput } from '@/lib/content/markdown-generator';
  import { loadKakaoSDK } from '@/lib/map/kakao-loader';

  interface ClientPlace {
    id: string;
    name: string;
    lat: number;
    lng: number;
    sido: string;
    sigungu: string;
    type?: string;
    facilities?: string[];
    tips?: string;
    hidden?: boolean;
  }

  // 클라이언트에 내장된 서버 데이터 읽기
  const placesScript = document.getElementById('server-places-data');
  const walksScript = document.getElementById('server-walks-data');

  let existingPlaces: ClientPlace[] = placesScript ? JSON.parse(placesScript.textContent || '[]') : [];
  let existingWalks = walksScript ? JSON.parse(walksScript.textContent || '[]') : [];

  // 선택된 방문 장소 ID 목록 (순서 유지)
  let selectedPlaceIds: string[] = [];

  // 새로 등록 대기 중인 장소 목록 (단일 세션 내 추가)
  let pendingNewPlaces: Map<string, PlaceInput> = new Map();

  // 현재 모드: 'new-walk' | 'edit-walk' | 'new-place'
  let currentMode = 'new-walk';

  // 로컬스토리지 키
  const STORAGE_PAT = 'picnic_github_pat';
  const STORAGE_DRAFT = 'picnic_walk_draft';

  // ==========================================
  // 1. GitHub 토큰 상태 및 모달 제어
  // ==========================================
  const patModal = document.getElementById('modal-pat');
  const patStatusDot = document.getElementById('pat-status-dot');
  const patStatusText = document.getElementById('pat-status-text');
  const inputPatToken = document.getElementById('input-pat-token') as HTMLInputElement | null;
  const patVerifyResult = document.getElementById('pat-verify-result');

  function updatePatUI(token: string | null, username?: string) {
    if (token && token.trim()) {
      if (patStatusDot) {
        patStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
      }
      if (patStatusText) {
        patStatusText.textContent = username ? `연결됨 (${username})` : 'GitHub 연결됨';
      }
    } else {
      if (patStatusDot) {
        patStatusDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
      }
      if (patStatusText) {
        patStatusText.textContent = 'GitHub 토큰 필요';
      }
    }
  }

  // 초기 토큰 확인
  const savedPat = localStorage.getItem(STORAGE_PAT);
  if (savedPat) {
    updatePatUI(savedPat);
    // 백그라운드에서 유효성 가벼운 확인
    verifyGithubToken(savedPat).then((res) => {
      if (res.valid) {
        updatePatUI(savedPat, res.username);
      } else {
        updatePatUI(null);
      }
    });
  }

  document.getElementById('btn-open-pat-modal')?.addEventListener('click', () => {
    if (inputPatToken) {
      inputPatToken.value = localStorage.getItem(STORAGE_PAT) || '';
    }
    if (patVerifyResult) {
      patVerifyResult.className = 'hidden';
      patVerifyResult.textContent = '';
    }
    patModal?.classList.remove('hidden');
  });

  document.getElementById('btn-close-pat-modal')?.addEventListener('click', () => {
    patModal?.classList.add('hidden');
  });

  document.getElementById('btn-save-pat')?.addEventListener('click', async () => {
    const token = inputPatToken?.value.trim() || '';
    if (!token) {
      alert('토큰을 입력해 주세요.');
      return;
    }

    if (patVerifyResult) {
      patVerifyResult.className = 'text-xs p-2.5 rounded-lg bg-stone-100 text-stone-600 block';
      patVerifyResult.textContent = '토큰 및 저장소 권한 확인 중...';
    }

    const res = await verifyGithubToken(token);
    if (res.valid) {
      localStorage.setItem(STORAGE_PAT, token);
      updatePatUI(token, res.username);
      if (patVerifyResult) {
        patVerifyResult.className = 'text-xs p-2.5 rounded-lg bg-emerald-50 text-emerald-700 block font-serif';
        patVerifyResult.textContent = `✓ 확인 완료! ${res.username} 계정으로 저장소 쓰기 권한이 확인되었습니다.`;
      }
      setTimeout(() => {
        patModal?.classList.add('hidden');
      }, 1000);
    } else {
      if (patVerifyResult) {
        patVerifyResult.className = 'text-xs p-2.5 rounded-lg bg-red-50 text-red-600 block';
        patVerifyResult.textContent = `❌ ${res.errorMessage || '토큰 확인 실패'}`;
      }
    }
  });

  document.getElementById('btn-remove-pat')?.addEventListener('click', () => {
    if (confirm('저장된 GitHub 토큰을 브라우저에서 삭제하시겠습니까?')) {
      localStorage.removeItem(STORAGE_PAT);
      updatePatUI(null);
      if (inputPatToken) inputPatToken.value = '';
      patModal?.classList.add('hidden');
    }
  });

  // ==========================================
  // 2. 모드 전환 (새 산책 / 기존 수정 / 새 장소)
  // ==========================================
  const tabNewWalk = document.getElementById('tab-mode-new-walk');
  const tabEditWalk = document.getElementById('tab-mode-edit-walk');
  const tabNewPlace = document.getElementById('tab-mode-new-place');
  const editWalkSelector = document.getElementById('edit-walk-selector');
  const sectionWalkInfo = document.getElementById('section-walk-info');
  const sectionWalkContent = document.getElementById('section-walk-content');
  const sectionPhotoSettings = document.getElementById('section-photo-settings');
  const btnSubmitText = document.getElementById('btn-submit-text');

  function setMode(mode: string) {
    currentMode = mode;
    const tabs = [tabNewWalk, tabEditWalk, tabNewPlace];
    tabs.forEach((t) => {
      t?.classList.remove('font-bold', 'text-forest-700', 'dark:text-forest-400', 'border-forest-600', 'dark:border-forest-400');
      t?.classList.add('text-stone-500', 'dark:text-stone-400', 'border-transparent');
    });

    if (mode === 'new-walk') {
      tabNewWalk?.classList.add('font-bold', 'text-forest-700', 'dark:text-forest-400', 'border-forest-600', 'dark:border-forest-400');
      editWalkSelector?.classList.add('hidden');
      sectionWalkInfo?.classList.remove('hidden');
      sectionWalkContent?.classList.remove('hidden');
      sectionPhotoSettings?.classList.remove('hidden');
      if (btnSubmitText) btnSubmitText.textContent = '서가에 보관하기';
    } else if (mode === 'edit-walk') {
      tabEditWalk?.classList.add('font-bold', 'text-forest-700', 'dark:text-forest-400', 'border-forest-600', 'dark:border-forest-400');
      editWalkSelector?.classList.remove('hidden');
      sectionWalkInfo?.classList.remove('hidden');
      sectionWalkContent?.classList.remove('hidden');
      sectionPhotoSettings?.classList.remove('hidden');
      if (btnSubmitText) btnSubmitText.textContent = '기록 수정 커밋하기';
    } else if (mode === 'new-place') {
      tabNewPlace?.classList.add('font-bold', 'text-forest-700', 'dark:text-forest-400', 'border-forest-600', 'dark:border-forest-400');
      // 장소 단독 모달 즉시 열기
      openNewPlaceModal();
    }
  }

  tabNewWalk?.addEventListener('click', () => setMode('new-walk'));
  tabEditWalk?.addEventListener('click', () => setMode('edit-walk'));
  tabNewPlace?.addEventListener('click', () => setMode('new-place'));

  // ==========================================
  // 3. 기존 산책 글 선택 시 폼 채우기
  // ==========================================
  const selectExistingWalk = document.getElementById('select-existing-walk') as HTMLSelectElement | null;
  selectExistingWalk?.addEventListener('change', () => {
    const slug = selectExistingWalk.value;
    if (!slug) return;

    const walk = existingWalks.find((w: any) => w.slug === slug);
    if (!walk) return;

    // 폼 값 주입
    (document.getElementById('input-title') as HTMLInputElement).value = walk.title || '';
    (document.getElementById('input-date') as HTMLInputElement).value = walk.date || '';
    (document.getElementById('select-time-of-day') as HTMLSelectElement).value = walk.timeOfDay || '';
    (document.getElementById('input-weather') as HTMLInputElement).value = walk.weather || '';
    (document.getElementById('input-companions') as HTMLInputElement).value = walk.companions || '';
    (document.getElementById('input-mood') as HTMLInputElement).value = walk.mood || '';
    (document.getElementById('input-tags') as HTMLInputElement).value = (walk.tags || []).join(', ');
    (document.getElementById('input-draft') as HTMLInputElement).checked = !!walk.draft;
    (document.getElementById('input-content') as HTMLTextAreaElement).value = walk.body || '';
    (document.getElementById('input-photo-folder') as HTMLInputElement).value = walk.photoFolder || '';
    (document.getElementById('input-cover') as HTMLInputElement).value = walk.cover || 'cover.webp';

    // 장소 선택 복원
    selectedPlaceIds = [...(walk.places || [])];
    renderSelectedPlaces();
    updateCharAndParaCount();
  });

  // ==========================================
  // 4. 방문 장소 칩 렌더링 & 빠른 추가
  // ==========================================
  const selectedPlacesContainer = document.getElementById('selected-places-container');
  const selectedPlacesCount = document.getElementById('selected-places-count');

  function renderSelectedPlaces() {
    if (!selectedPlacesContainer) return;
    selectedPlacesContainer.innerHTML = '';

    if (selectedPlacesCount) {
      selectedPlacesCount.textContent = String(selectedPlaceIds.length);
    }

    if (selectedPlaceIds.length === 0) {
      const msg = document.createElement('span');
      msg.className = 'text-xs text-stone-400 font-serif';
      msg.textContent = '아래 기존 서가 목록에서 선택하거나 [+ 새 장소 추가하기]를 누르세요.';
      selectedPlacesContainer.appendChild(msg);
      return;
    }

    selectedPlaceIds.forEach((id) => {
      // 기존 장소 또는 신규 추가 대기 장소에서 이름 조회
      const existing = existingPlaces.find((p: any) => p.id === id);
      const pending = pendingNewPlaces.get(id);
      const name = existing ? existing.name : pending ? pending.name : id;
      const isPending = !!pending;

      const chip = document.createElement('div');
      chip.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-serif font-medium border ${
        isPending
          ? 'bg-amber-50 text-amber-900 border-amber-300 dark:bg-amber-950 dark:text-amber-200 dark:border-amber-800'
          : 'bg-forest-50 text-forest-800 border-forest-200 dark:bg-forest-950 dark:text-forest-200 dark:border-forest-800'
      }`;

      chip.innerHTML = `
        <span>📍 ${name}</span>
        ${isPending ? '<span class="text-[10px] text-amber-600 dark:text-amber-400 font-sans font-bold">(신규)</span>' : ''}
        <button type="button" data-remove-id="${id}" class="hover:text-red-500 font-bold ml-0.5">✕</button>
      `;

      chip.querySelector('button')?.addEventListener('click', () => {
        selectedPlaceIds = selectedPlaceIds.filter((p) => p !== id);
        renderSelectedPlaces();
      });

      selectedPlacesContainer.appendChild(chip);
    });
  }

  // 기존 서가 장소 빠른 추가 버튼 이벤트
  document.querySelectorAll('.btn-quick-add-place').forEach((btn) => {
    btn.addEventListener('click', () => {
      const placeId = btn.getAttribute('data-place-id');
      if (placeId && !selectedPlaceIds.includes(placeId)) {
        selectedPlaceIds.push(placeId);
        renderSelectedPlaces();
      }
    });
  });

  // ==========================================
  // 5. 새 장소 추가 모달 및 카카오 연동
  // ==========================================
  const newPlaceModal = document.getElementById('modal-new-place');
  const inputKakaoSearch = document.getElementById('input-kakao-search') as HTMLInputElement | null;
  const kakaoSearchResults = document.getElementById('kakao-search-results');
  const nearbyWarningBanner = document.getElementById('nearby-warning-banner');
  const nearbyWarningText = document.getElementById('nearby-warning-text');
  const btnUseNearbyPlace = document.getElementById('btn-use-nearby-place');

  let kakaoSDKLoaded = false;
  let kakaoPlacesService: any = null;
  let kakaoGeocoderService: any = null;
  let detectedNearbyPlaceId: string | null = null;

  async function initKakaoServices() {
    if (kakaoSDKLoaded) return;
    try {
      const kakao = await loadKakaoSDK();
      if (kakao && kakao.maps && kakao.maps.services) {
        kakaoPlacesService = new kakao.maps.services.Places();
        kakaoGeocoderService = new kakao.maps.services.Geocoder();
        kakaoSDKLoaded = true;
      }
    } catch (e) {
      console.warn('카카오맵 서비스 로더 알림:', e);
    }
  }

  function openNewPlaceModal() {
    newPlaceModal?.classList.remove('hidden');
    initKakaoServices();
  }

  function closeNewPlaceModal() {
    newPlaceModal?.classList.add('hidden');
    if (currentMode === 'new-place') {
      setMode('new-walk');
    }
  }

  document.getElementById('btn-toggle-new-place-modal')?.addEventListener('click', openNewPlaceModal);
  document.getElementById('btn-close-new-place-modal')?.addEventListener('click', closeNewPlaceModal);
  document.getElementById('btn-cancel-new-place')?.addEventListener('click', closeNewPlaceModal);

  // 카카오 키워드 검색 실행
  async function searchKakaoKeyword() {
    const query = inputKakaoSearch?.value.trim();
    if (!query) return;

    await initKakaoServices();
    if (!kakaoPlacesService) {
      alert('카카오맵 서비스를 초기화할 수 없습니다. 키 설정을 확인하세요.');
      return;
    }

    kakaoPlacesService.keywordSearch(query, (data: any[], status: any) => {
      if (status === window.kakao.maps.services.Status.OK) {
        renderSearchResults(data);
      } else {
        if (kakaoSearchResults) {
          kakaoSearchResults.classList.remove('hidden');
          kakaoSearchResults.innerHTML = '<div class="text-stone-400 p-2 text-center">검색 결과가 없습니다.</div>';
        }
      }
    });
  }

  document.getElementById('btn-kakao-search')?.addEventListener('click', searchKakaoKeyword);
  inputKakaoSearch?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      searchKakaoKeyword();
    }
  });

  // 검색 결과 렌더링
  function renderSearchResults(items: any[]) {
    if (!kakaoSearchResults) return;
    kakaoSearchResults.classList.remove('hidden');
    kakaoSearchResults.innerHTML = '';

    items.slice(0, 5).forEach((item) => {
      const row = document.createElement('div');
      row.className = 'p-2 rounded-lg hover:bg-forest-50 dark:hover:bg-forest-950/60 cursor-pointer border border-transparent hover:border-forest-200 transition-colors';
      row.innerHTML = `
        <div class="font-bold text-stone-900 dark:text-stone-100">${item.place_name}</div>
        <div class="text-[11px] text-stone-500">${item.road_address_name || item.address_name}</div>
      `;
      row.addEventListener('click', () => {
        applyKakaoPlaceSelection(item);
      });
      kakaoSearchResults.appendChild(row);
    });
  }

  // 장소 선택 시 폼 자동 완성 및 83개 정규화 & 반경 200m 중복 감지
  function applyKakaoPlaceSelection(item: any) {
    const lat = parseFloat(item.y);
    const lng = parseFloat(item.x);
    const placeName = item.place_name;

    (document.getElementById('input-place-name') as HTMLInputElement).value = placeName;
    (document.getElementById('input-place-lat') as HTMLInputElement).value = String(lat);
    (document.getElementById('input-place-lng') as HTMLInputElement).value = String(lng);

    // 슬러그 자동 생성 (영문 또는 한글 변환 기반)
    const slugInput = document.getElementById('input-place-slug') as HTMLInputElement;
    if (!slugInput.value) {
      slugInput.value = generatePlaceSlug(placeName);
    }

    kakaoSearchResults?.classList.add('hidden');

    // 1. 역지오코딩을 통한 83개 정규화
    if (kakaoGeocoderService) {
      kakaoGeocoderService.coord2RegionCode(lng, lat, (result: any[], status: any) => {
        if (status === window.kakao.maps.services.Status.OK) {
          const region = result.find((r) => r.region_type === 'H') || result[0];
          if (region) {
            const normalized = normalizeDistrict(
              region.region_1depth_name,
              region.region_2depth_name,
              region.region_3depth_name
            );
            if (normalized) {
              (document.getElementById('select-place-sido') as HTMLSelectElement).value = normalized.sido;
              (document.getElementById('input-place-sigungu') as HTMLInputElement).value = normalized.sigungu;
            }
          }
        }
      });
    }

    // 2. 반경 200m 중복 장소 감지
    checkNearbyExistingPlaces(lat, lng);
  }

  function checkNearbyExistingPlaces(lat: number, lng: number) {
    const nearby = findNearbyPlaces(lat, lng, existingPlaces, 200);
    if (nearby.length > 0) {
      const closest = nearby[0];
      detectedNearbyPlaceId = closest.place.id;
      if (nearbyWarningBanner && nearbyWarningText) {
        nearbyWarningBanner.classList.remove('hidden');
        nearbyWarningText.textContent = `💡 반경 ${closest.distance}m 거리에 이미 서가에 등록된 '${closest.place.name}'이(가) 있습니다. 동일한 장소라면 새로 생성하지 않고 기존 장소를 재방문으로 연결할 수 있습니다.`;
      }
    } else {
      nearbyWarningBanner?.classList.add('hidden');
      detectedNearbyPlaceId = null;
    }
  }

  btnUseNearbyPlace?.addEventListener('click', () => {
    if (detectedNearbyPlaceId) {
      if (!selectedPlaceIds.includes(detectedNearbyPlaceId)) {
        selectedPlaceIds.push(detectedNearbyPlaceId);
        renderSelectedPlaces();
      }
      closeNewPlaceModal();
    }
  });

  // HTML5 Geolocation 현재 위치 가져오기
  document.getElementById('btn-get-current-pos')?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      alert('이 브라우저는 위치 정보(Geolocation)를 지원하지 않습니다.');
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        (document.getElementById('input-place-lat') as HTMLInputElement).value = String(lat);
        (document.getElementById('input-place-lng') as HTMLInputElement).value = String(lng);

        // 좌표를 바탕으로 주소 변환
        initKakaoServices().then(() => {
          if (kakaoGeocoderService) {
            kakaoGeocoderService.coord2RegionCode(lng, lat, (result: any[], status: any) => {
              if (status === window.kakao.maps.services.Status.OK) {
                const region = result.find((r) => r.region_type === 'H') || result[0];
                if (region) {
                  const placeName = `${region.region_3depth_name} 산책길`;
                  (document.getElementById('input-place-name') as HTMLInputElement).value = placeName;
                  const normalized = normalizeDistrict(
                    region.region_1depth_name,
                    region.region_2depth_name,
                    region.region_3depth_name
                  );
                  if (normalized) {
                    (document.getElementById('select-place-sido') as HTMLSelectElement).value = normalized.sido;
                    (document.getElementById('input-place-sigungu') as HTMLInputElement).value = normalized.sigungu;
                  }
                  checkNearbyExistingPlaces(lat, lng);
                }
              }
            });
          }
        });
      },
      (err) => {
        alert(`위치 정보를 가져올 수 없습니다: ${err.message}`);
      },
      { enableHighAccuracy: true, timeout: 10000 }
    );
  });

  function generatePlaceSlug(name: string) {
    return name
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-가-힣]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 25);
  }

  // 새 장소 등록 확정 버튼
  document.getElementById('btn-confirm-new-place')?.addEventListener('click', () => {
    const name = (document.getElementById('input-place-name') as HTMLInputElement).value.trim();
    const slug = (document.getElementById('input-place-slug') as HTMLInputElement).value.trim();
    const latStr = (document.getElementById('input-place-lat') as HTMLInputElement).value.trim();
    const lngStr = (document.getElementById('input-place-lng') as HTMLInputElement).value.trim();
    const sido = (document.getElementById('select-place-sido') as HTMLSelectElement).value as any;
    const sigungu = (document.getElementById('input-place-sigungu') as HTMLInputElement).value.trim();
    const type = ((document.querySelector('input[name="place-type"]:checked') as HTMLInputElement)?.value || '공원') as any;
    const tips = (document.getElementById('input-place-tips') as HTMLInputElement).value.trim();
    const description = (document.getElementById('input-place-desc') as HTMLTextAreaElement).value.trim();

    const facilities: string[] = [];
    document.querySelectorAll('input[name="place-facility"]:checked').forEach((cb) => {
      facilities.push((cb as HTMLInputElement).value);
    });

    if (!name || !slug || !latStr || !lngStr || !sigungu) {
      alert('장소명, 영문 ID, 위도, 경도, 시군구는 필수 입력 항목입니다.');
      return;
    }

    const lat = parseFloat(latStr);
    const lng = parseFloat(lngStr);

    const newPlaceObj: PlaceInput = {
      id: slug,
      name,
      lat,
      lng,
      sido,
      sigungu,
      type,
      facilities,
      tips,
      description,
      hidden: false,
    };

    pendingNewPlaces.set(slug, newPlaceObj);
    if (!selectedPlaceIds.includes(slug)) {
      selectedPlaceIds.push(slug);
    }

    renderSelectedPlaces();
    closeNewPlaceModal();
    alert(`✓ '${name}' 장소가 등록 목록에 추가되었습니다.`);
  });

  // ==========================================
  // 6. 에디터 툴바 & 실시간 글자수/미리보기
  // ==========================================
  const inputContent = document.getElementById('input-content') as HTMLTextAreaElement | null;
  const contentWriteWrapper = document.getElementById('content-write-wrapper');
  const contentPreviewWrapper = document.getElementById('content-preview-wrapper');
  const btnTabWrite = document.getElementById('btn-tab-write');
  const btnTabPreview = document.getElementById('btn-tab-preview');
  const charCount = document.getElementById('char-count');
  const paraCount = document.getElementById('para-count');

  function updateCharAndParaCount() {
    const text = inputContent?.value || '';
    if (charCount) charCount.textContent = String(text.length);
    if (paraCount) {
      const paras = text.split(/\n\s*\n/).filter((p) => p.trim().length > 0);
      paraCount.textContent = String(paras.length);
    }
  }

  inputContent?.addEventListener('input', updateCharAndParaCount);

  // 마크다운 빠른 서식 삽입 버튼
  document.querySelectorAll('.btn-md-insert').forEach((btn) => {
    btn.addEventListener('click', () => {
      const template = btn.getAttribute('data-md');
      if (!template || !inputContent) return;

      const start = inputContent.selectionStart;
      const end = inputContent.selectionEnd;
      const text = inputContent.value;

      inputContent.value = text.slice(0, start) + template + text.slice(end);
      inputContent.focus();
      inputContent.setSelectionRange(start + template.length, start + template.length);
      updateCharAndParaCount();
    });
  });

  // 간단한 클라이언트 마크다운 렌더러
  function renderMarkdownPreview(raw: string) {
    if (!raw.trim()) return '<p class="text-stone-400 italic">아직 작성된 내용이 없습니다.</p>';
    const lines = raw.split('\n');
    let html = '';
    let inList = false;

    lines.forEach((line) => {
      const trimmed = line.trim();
      if (trimmed.startsWith('### ')) {
        html += `<h3 class="text-lg font-bold font-serif mt-4 mb-2">${escapeHtml(trimmed.slice(4))}</h3>`;
      } else if (trimmed.startsWith('## ')) {
        html += `<h2 class="text-xl font-bold font-serif mt-5 mb-2">${escapeHtml(trimmed.slice(3))}</h2>`;
      } else if (trimmed.startsWith('> ')) {
        html += `<blockquote class="border-l-4 border-forest-500 pl-3 italic my-3 text-stone-600 dark:text-stone-300">${escapeHtml(trimmed.slice(2))}</blockquote>`;
      } else if (trimmed === '---') {
        html += `<hr class="my-4 border-stone-200 dark:border-stone-700" />`;
      } else if (trimmed.startsWith('- ')) {
        if (!inList) { html += '<ul class="list-disc pl-5 my-2">'; inList = true; }
        html += `<li>${escapeHtml(trimmed.slice(2))}</li>`;
      } else if (trimmed === '') {
        if (inList) { html += '</ul>'; inList = false; }
      } else {
        if (inList) { html += '</ul>'; inList = false; }
        // 굵게/기울임
        let p = escapeHtml(line);
        p = p.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        p = p.replace(/\*(.*?)\*/g, '<em>$1</em>');
        html += `<p class="my-2 leading-relaxed font-serif">${p}</p>`;
      }
    });

    if (inList) html += '</ul>';
    return html;
  }

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.innerText = text;
    return div.innerHTML;
  }

  btnTabWrite?.addEventListener('click', () => {
    btnTabWrite.className = 'px-2.5 py-1 rounded-md font-medium bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-2xs';
    btnTabPreview?.classList.remove('bg-white', 'dark:bg-stone-700', 'text-stone-900', 'dark:text-stone-100', 'shadow-2xs');
    btnTabPreview?.classList.add('text-stone-500', 'dark:text-stone-400');
    contentWriteWrapper?.classList.remove('hidden');
    contentPreviewWrapper?.classList.add('hidden');
  });

  btnTabPreview?.addEventListener('click', () => {
    btnTabPreview.className = 'px-2.5 py-1 rounded-md font-medium bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-2xs';
    btnTabWrite?.classList.remove('bg-white', 'dark:bg-stone-700', 'text-stone-900', 'dark:text-stone-100', 'shadow-2xs');
    btnTabWrite?.classList.add('text-stone-500', 'dark:text-stone-400');
    if (contentPreviewWrapper) {
      contentPreviewWrapper.innerHTML = renderMarkdownPreview(inputContent?.value || '');
    }
    contentWriteWrapper?.classList.add('hidden');
    contentPreviewWrapper?.classList.remove('hidden');
  });

  // ==========================================
  // 7. 자동 임시저장 & 복구
  // ==========================================
  function saveDraftToStorage() {
    const draftData = {
      title: (document.getElementById('input-title') as HTMLInputElement)?.value || '',
      date: (document.getElementById('input-date') as HTMLInputElement)?.value || '',
      timeOfDay: (document.getElementById('select-time-of-day') as HTMLSelectElement)?.value || '',
      weather: (document.getElementById('input-weather') as HTMLInputElement)?.value || '',
      companions: (document.getElementById('input-companions') as HTMLInputElement)?.value || '',
      mood: (document.getElementById('input-mood') as HTMLInputElement)?.value || '',
      tags: (document.getElementById('input-tags') as HTMLInputElement)?.value || '',
      draft: (document.getElementById('input-draft') as HTMLInputElement)?.checked || false,
      content: inputContent?.value || '',
      places: selectedPlaceIds,
      timestamp: Date.now(),
    };
    localStorage.setItem(STORAGE_DRAFT, JSON.stringify(draftData));
  }

  // 오늘 날짜를 기본값으로 설정
  const todayStr = new Date().toISOString().split('T')[0];
  const dateInput = document.getElementById('input-date') as HTMLInputElement;
  if (dateInput && !dateInput.value) {
    dateInput.value = todayStr;
  }

  // 임시저장 버튼 수동 클릭
  document.getElementById('btn-manual-save')?.addEventListener('click', () => {
    saveDraftToStorage();
    alert('✓ 브라우저에 현재 작성 내용이 임시 저장되었습니다.');
  });

  // 15초마다 자동 임시저장
  setInterval(saveDraftToStorage, 15000);

  // 초기 로드 시 미완성 드래프트 존재 확인
  const savedDraft = localStorage.getItem(STORAGE_DRAFT);
  if (savedDraft) {
    try {
      const parsed = JSON.parse(savedDraft);
      if (parsed.title || parsed.content) {
        // 복구 제안
        const confirmRestore = confirm(`이전에 작성 중이던 임시 저장본("${parsed.title || '제목 없음'}")이 있습니다. 복구하시겠습니까?`);
        if (confirmRestore) {
          (document.getElementById('input-title') as HTMLInputElement).value = parsed.title || '';
          if (parsed.date) (document.getElementById('input-date') as HTMLInputElement).value = parsed.date;
          if (parsed.timeOfDay) (document.getElementById('select-time-of-day') as HTMLSelectElement).value = parsed.timeOfDay;
          if (parsed.weather) (document.getElementById('input-weather') as HTMLInputElement).value = parsed.weather;
          if (parsed.companions) (document.getElementById('input-companions') as HTMLInputElement).value = parsed.companions;
          if (parsed.mood) (document.getElementById('input-mood') as HTMLInputElement).value = parsed.mood;
          if (parsed.tags) (document.getElementById('input-tags') as HTMLInputElement).value = parsed.tags;
          if (inputContent) inputContent.value = parsed.content || '';
          if (parsed.places && Array.isArray(parsed.places)) {
            selectedPlaceIds = parsed.places;
            renderSelectedPlaces();
          }
          updateCharAndParaCount();
        }
      }
    } catch (e) {}
  }

  // ==========================================
  // 8. 서가에 기록 꽂기 (GitHub 원자적 커밋)
  // ==========================================
  const writeForm = document.getElementById('write-form');
  const commitModal = document.getElementById('modal-commit-progress');
  const commitStatusTitle = document.getElementById('commit-status-title');
  const commitStatusStep = document.getElementById('commit-status-step');
  const commitSpinner = document.getElementById('commit-spinner');
  const commitCheckIcon = document.getElementById('commit-check-icon');
  const commitSuccessActions = document.getElementById('commit-success-actions');
  const linkCommitView = document.getElementById('link-commit-view') as HTMLAnchorElement | null;

  writeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // 1. 토큰 확인
    const pat = localStorage.getItem(STORAGE_PAT);
    if (!pat || !pat.trim()) {
      alert('GitHub Personal Access Token이 설정되지 않았습니다. 우측 상단 토큰 설정을 먼저 완료해 주세요.');
      patModal?.classList.remove('hidden');
      return;
    }

    // 2. 유효성 검사
    const title = (document.getElementById('input-title') as HTMLInputElement).value.trim();
    const date = (document.getElementById('input-date') as HTMLInputElement).value.trim();
    const content = inputContent?.value || '';

    if (!title) {
      alert('산책 제목은 필수입니다.');
      return;
    }
    if (!date) {
      alert('방문 날짜는 필수입니다.');
      return;
    }
    if (selectedPlaceIds.length === 0) {
      alert('최소 1개 이상의 방문 장소를 서가에서 연결하거나 새 장소를 추가해 주세요.');
      return;
    }

    // 3. 커밋할 파일 목록 패키징
    const filesToCommit: Array<{ path: string; content: string }> = [];

    // 3-1. 신규 장소 파일들
    selectedPlaceIds.forEach((placeId) => {
      if (pendingNewPlaces.has(placeId)) {
        const placeObj = pendingNewPlaces.get(placeId)!;
        const placeMarkdown = generatePlaceMarkdown(placeObj);
        filesToCommit.push({
          path: `src/content/places/${placeId}.md`,
          content: placeMarkdown,
        });
      }
    });

    // 3-2. 산책 기록 파일
    const timeOfDay = (document.getElementById('select-time-of-day') as HTMLSelectElement).value as any;
    const weather = (document.getElementById('input-weather') as HTMLInputElement).value.trim();
    const companions = (document.getElementById('input-companions') as HTMLInputElement).value.trim();
    const mood = (document.getElementById('input-mood') as HTMLInputElement).value.trim();
    const tagsRaw = (document.getElementById('input-tags') as HTMLInputElement).value.trim();
    const tags = tagsRaw ? tagsRaw.split(',').map((t) => t.trim()).filter(Boolean) : [];
    const draft = (document.getElementById('input-draft') as HTMLInputElement).checked;

    // 슬러그 결정
    let walkSlug = '';
    if (currentMode === 'edit-walk' && selectExistingWalk?.value) {
      walkSlug = selectExistingWalk.value;
    } else {
      const firstPlace = selectedPlaceIds[0];
      walkSlug = `${date}-${firstPlace}`;
    }

    const photoFolder = (document.getElementById('input-photo-folder') as HTMLInputElement).value.trim() || walkSlug;
    const cover = (document.getElementById('input-cover') as HTMLInputElement).value.trim() || 'cover.webp';

    const walkObj: WalkInput = {
      slug: walkSlug,
      title,
      date,
      timeOfDay,
      weather,
      companions,
      mood,
      places: selectedPlaceIds,
      photoFolder,
      cover,
      tags,
      draft,
      content,
    };

    const walkMarkdown = generateWalkMarkdown(walkObj);
    filesToCommit.push({
      path: `src/content/walks/${walkSlug}.md`,
      content: walkMarkdown,
    });

    // 4. 모달 열고 진행 표시
    commitModal?.classList.remove('hidden');
    if (commitStatusTitle) commitStatusTitle.textContent = '서가에 보관 중...';
    if (commitSpinner) commitSpinner.classList.remove('hidden');
    if (commitCheckIcon) commitCheckIcon.classList.add('hidden');
    commitSuccessActions?.classList.add('hidden');

    try {
      const commitMessage = currentMode === 'edit-walk'
        ? `feat(walks): update walk record "${title}" (${date})`
        : `feat(walks): add walk record "${title}" (${date})`;

      const result = await atomicCommitFiles(
        {
          pat,
          commitMessage,
          files: filesToCommit,
        },
        (step) => {
          if (commitStatusStep) commitStatusStep.textContent = step;
        }
      );

      // 성공 완료
      if (commitStatusTitle) commitStatusTitle.textContent = '서가 보관 완료! 🌿';
      if (commitStatusStep) commitStatusStep.textContent = 'GitHub 커밋 및 Actions 배포가 시작되었습니다.';
      if (commitSpinner) commitSpinner.classList.add('hidden');
      if (commitCheckIcon) commitCheckIcon.classList.remove('hidden');
      if (linkCommitView) linkCommitView.href = result.commitUrl;
      commitSuccessActions?.classList.remove('hidden');

      // 임시 저장본 삭제
      localStorage.removeItem(STORAGE_DRAFT);
    } catch (err: any) {
      alert(`커밋 중 오류가 발생했습니다: ${err.message}`);
      commitModal?.classList.add('hidden');
    }
  });
</script>
