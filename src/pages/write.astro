---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { baseUrl } from '@/lib/utils/url';
import { ALL_83_DISTRICTS } from '@/lib/geo/districts';
import {
  PenTool,
  BookOpen,
  MapPin,
  Sparkles,
  Plus,
  Search,
  Check,
  CircleAlert,
  Key,
  RefreshCw,
  ExternalLink,
  Crosshair,
  Save,
  Send,
  Layers,
  X,
} from '@lucide/astro';

// 빌드 시점에 기존 장소 및 산책 목록 로드
const allPlaces = await getCollection('places');
const allWalks = await getCollection('walks');

// 최신 날짜순 정렬
allWalks.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const initialPlaces = allPlaces.map((p) => ({
  id: p.id,
  name: p.data.name,
  lat: p.data.lat,
  lng: p.data.lng,
  sido: p.data.sido,
  sigungu: p.data.sigungu,
  type: p.data.type,
  facilities: p.data.facilities || [],
  tips: p.data.tips || '',
  hidden: p.data.hidden || false,
}));

const initialWalks = allWalks.map((w) => ({
  slug: w.id,
  title: w.data.title,
  date: w.data.date,
  timeOfDay: w.data.timeOfDay || '',
  weather: w.data.weather || '',
  companions: w.data.companions || '',
  mood: w.data.mood || '',
  places: w.data.places.map((p) => (typeof p === 'string' ? p : p.id)),
  photoFolder: w.data.photoFolder || '',
  cover: w.data.cover || '',
  captions: w.data.captions || {},
  tags: w.data.tags || [],
  draft: w.data.draft || false,
  body: w.body || '',
}));
---

<BaseLayout title="사서의 기록 데스크" description="새 산책 기록을 서가에 꽂는 사서의 집무실입니다." noindex={true}>
  <!-- 데이터 주입용 JSON 스크립트 -->
  <script id="server-places-data" type="application/json" set:html={JSON.stringify(initialPlaces)} />
  <script id="server-walks-data" type="application/json" set:html={JSON.stringify(initialWalks)} />
  <script id="server-districts-data" type="application/json" set:html={JSON.stringify(ALL_83_DISTRICTS)} />

  <div class="min-h-screen bg-stone-100/70 dark:bg-stone-950 py-6 px-4 sm:px-6 transition-colors">
    <div class="max-w-4xl mx-auto space-y-6">

      <!-- 상단 헤더 & 사서 데스크 타이틀 -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white/80 dark:bg-stone-900/80 backdrop-blur-md p-5 sm:p-6 rounded-2xl border border-stone-200/80 dark:border-stone-800 shadow-sm">
        <div>
          <div class="flex items-center gap-2 text-forest-700 dark:text-forest-400 text-xs font-serif font-medium mb-1">
            <PenTool class="w-3.5 h-3.5" />
            <span>숲 속의 도서관 · 사서의 기록 데스크</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-serif font-bold text-stone-900 dark:text-paper-100">
            산책 기록 보관 및 앨범 편철
          </h1>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-0.5">
            이곳에서 작성한 글과 새 장소는 GitHub 저장소에 원자적으로 커밋되어 자동 배포됩니다.
          </p>
        </div>

        <!-- 깃허브 토큰 연결 상태 & 설정 버튼 -->
        <div class="flex items-center gap-2 self-start sm:self-auto">
          <button
            id="btn-open-pat-modal"
            type="button"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-medium border transition-all cursor-pointer bg-stone-50 hover:bg-stone-100 dark:bg-stone-800 dark:hover:bg-stone-700/80 text-stone-700 dark:text-stone-200 border-stone-300 dark:border-stone-700 shadow-2xs"
          >
            <span id="pat-status-dot" class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            <span id="pat-status-text">GitHub 토큰 필요</span>
            <Key class="w-3 h-3 text-stone-400" />
          </button>

          <button
            id="btn-manual-save"
            type="button"
            title="브라우저 임시보관"
            class="p-2 rounded-xl text-stone-500 hover:text-stone-800 dark:hover:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800 border border-stone-200 dark:border-stone-800 transition-colors"
          >
            <Save class="w-4 h-4" />
          </button>
        </div>
      </div>

      <!-- 작업 모드 탭 (새 산책 / 기존 기록 수정 / 새 장소 단독 등록) -->
      <div class="flex border-b border-stone-200 dark:border-stone-800 gap-2 sm:gap-4 text-sm font-serif">
        <button
          id="tab-mode-new-walk"
          class="tab-btn px-4 py-2.5 font-bold text-forest-700 dark:text-forest-400 border-b-2 border-forest-600 dark:border-forest-400 flex items-center gap-2"
        >
          <PenTool class="w-4 h-4" />
          <span>새 산책 기록하기</span>
        </button>
        <button
          id="tab-mode-edit-walk"
          class="tab-btn px-4 py-2.5 text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 border-b-2 border-transparent flex items-center gap-2"
        >
          <BookOpen class="w-4 h-4" />
          <span>기존 기록 수정</span>
        </button>
        <button
          id="tab-mode-new-place"
          class="tab-btn px-4 py-2.5 text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 border-b-2 border-transparent flex items-center gap-2"
        >
          <MapPin class="w-4 h-4" />
          <span>새 장소 단독 등록</span>
        </button>
      </div>

      <!-- 기존 글 수정 선택기 (기존 글 수정 모드 시 표시) -->
      <div id="edit-walk-selector" class="hidden bg-stone-50 dark:bg-stone-900 p-4 rounded-xl border border-stone-200 dark:border-stone-800">
        <label for="select-existing-walk" class="block text-xs font-serif font-bold text-stone-700 dark:text-stone-300 mb-2">
          수정할 산책 기록 선택 ({initialWalks.length}편 보관 중)
        </label>
        <select
          id="select-existing-walk"
          class="w-full px-3 py-2 text-sm rounded-lg bg-white dark:bg-stone-800 border border-stone-300 dark:border-stone-700 text-stone-900 dark:text-paper-100 focus:ring-2 focus:ring-forest-500 outline-none"
        >
          <option value="">-- 수정할 산책을 선택하세요 --</option>
          {initialWalks.map((w) => (
            <option value={w.slug}>
              [{w.date}] {w.title} ({w.places.join(', ')})
            </option>
          ))}
        </select>
      </div>

      <!-- 메인 폼 영역 -->
      <form id="write-form" class="space-y-6">

        <!-- 1. 기본 산책 정보 카드 (새 산책 / 수정 모드에서 활성화) -->
        <div id="section-walk-info" class="bg-white/90 dark:bg-stone-900/90 backdrop-blur-md p-5 sm:p-6 rounded-2xl border border-stone-200/80 dark:border-stone-800 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800/80 pb-3">
            <h2 class="text-base font-serif font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2">
              <Sparkles class="w-4 h-4 text-forest-600 dark:text-forest-400" />
              <span>1. 산책의 개요</span>
            </h2>
            <label class="inline-flex items-center gap-2 text-xs text-stone-600 dark:text-stone-400 cursor-pointer">
              <input type="checkbox" id="input-draft" class="rounded border-stone-300 text-forest-600 focus:ring-forest-500" />
              <span>비공개 초안(Draft)으로 저장</span>
            </label>
          </div>

          <!-- 산책 제목 -->
          <div>
            <label for="input-title" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
              산책 제목 <span class="text-terracotta-500">*</span>
            </label>
            <input
              type="text"
              id="input-title"
              required
              placeholder="예: 초가을 바람과 메타세쿼이아 그늘, 서울숲"
              class="w-full px-3.5 py-2.5 text-sm sm:text-base rounded-xl bg-stone-50 dark:bg-stone-800/80 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none transition-all placeholder:text-stone-400"
            />
          </div>

          <!-- 일자 & 시간대 & 날씨 -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label for="input-date" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                방문 일자 <span class="text-terracotta-500">*</span>
              </label>
              <div class="relative">
                <input
                  type="date"
                  id="input-date"
                  required
                  class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                시간대
              </label>
              <select
                id="select-time-of-day"
                class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none"
              >
                <option value="">선택 안 함</option>
                <option value="아침">아침 (새벽~오전)</option>
                <option value="낮" selected>낮 (오후)</option>
                <option value="저녁">저녁 (해질녘)</option>
                <option value="밤">밤 (야경)</option>
              </select>
            </div>

            <div>
              <label for="input-weather" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                날씨
              </label>
              <input
                type="text"
                id="input-weather"
                placeholder="예: 맑고 선선함"
                class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none"
              />
            </div>
          </div>

          <!-- 동행 & 기분/무드 & 태그 -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label for="input-companions" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                동행
              </label>
              <input
                type="text"
                id="input-companions"
                placeholder="예: 혼자 / 반려견과"
                class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none"
              />
            </div>

            <div>
              <label for="input-mood" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                기분 또는 한 줄 인상
              </label>
              <input
                type="text"
                id="input-mood"
                placeholder="예: 🌿 평온 / ☕ 여유"
                class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none"
              />
            </div>

            <div>
              <label for="input-tags" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                태그 (쉼표로 구분)
              </label>
              <input
                type="text"
                id="input-tags"
                placeholder="가을, 숲길, 사색"
                class="w-full px-3 py-2 text-xs sm:text-sm rounded-xl bg-stone-50 dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none"
              />
            </div>
          </div>
        </div>

        <!-- 2. 방문 장소 연결 및 새 장소 등록 카드 -->
        <div class="bg-white/90 dark:bg-stone-900/90 backdrop-blur-md p-5 sm:p-6 rounded-2xl border border-stone-200/80 dark:border-stone-800 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800/80 pb-3">
            <div>
              <h2 class="text-base font-serif font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2">
                <MapPin class="w-4 h-4 text-forest-600 dark:text-forest-400" />
                <span>2. 방문 장소 (서가의 앨범) 연결</span>
              </h2>
              <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">
                산책에서 들른 장소를 선택하세요. 한 산책에 여러 장소를 연결할 수 있습니다.
              </p>
            </div>

            <button
              id="btn-toggle-new-place-modal"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-serif font-medium bg-forest-50 hover:bg-forest-100 dark:bg-forest-950/60 dark:hover:bg-forest-900 text-forest-700 dark:text-forest-300 border border-forest-200/80 dark:border-forest-800 transition-colors"
            >
              <Plus class="w-3.5 h-3.5" />
              <span>+ 새 장소 추가하기</span>
            </button>
          </div>

          <!-- 현재 선택된 장소 칩 목록 -->
          <div>
            <span class="block text-xs font-serif font-medium text-stone-600 dark:text-stone-400 mb-2">
              선택된 방문 장소 (<span id="selected-places-count">0</span>곳) <span class="text-terracotta-500">*</span>
            </span>
            <div id="selected-places-container" class="flex flex-wrap gap-2 min-h-10 p-2.5 rounded-xl bg-stone-50 dark:bg-stone-800/60 border border-dashed border-stone-300 dark:border-stone-700 items-center">
              <span id="no-places-msg" class="text-xs text-stone-400 font-serif">
                아래 기존 서가 목록에서 선택하거나 [+ 새 장소 추가하기]를 누르세요.
              </span>
            </div>
          </div>

          <!-- 기존 서가 장소 빠른 선택 리스트 -->
          <div class="pt-2">
            <span class="block text-xs font-serif font-medium text-stone-600 dark:text-stone-400 mb-2">
              기존 서가 장소에서 추가:
            </span>
            <div class="flex flex-wrap gap-1.5 max-h-32 overflow-y-auto p-1 text-xs">
              {initialPlaces.map((p) => (
                <button
                  type="button"
                  data-place-id={p.id}
                  data-place-name={p.name}
                  data-place-sigungu={p.sigungu}
                  class="btn-quick-add-place px-2.5 py-1 rounded-lg bg-stone-100 hover:bg-forest-50 dark:bg-stone-800 dark:hover:bg-forest-950/60 text-stone-700 hover:text-forest-700 dark:text-stone-300 dark:hover:text-forest-300 border border-stone-200 dark:border-stone-700 transition-colors flex items-center gap-1"
                >
                  <Plus class="w-3 h-3 text-stone-400" />
                  <span>{p.name}</span>
                  <span class="text-[10px] text-stone-400">({p.sigungu})</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- 3. 산책 감상 에세이 작성 영역 -->
        <div id="section-walk-content" class="bg-white/90 dark:bg-stone-900/90 backdrop-blur-md p-5 sm:p-6 rounded-2xl border border-stone-200/80 dark:border-stone-800 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800/80 pb-3">
            <div>
              <h2 class="text-base font-serif font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2">
                <PenTool class="w-4 h-4 text-forest-600 dark:text-forest-400" />
                <span>3. 산책 에세이 (기록 본문)</span>
              </h2>
              <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">
                마크다운(Markdown) 서식을 지원합니다. 책장의 페이지처럼 편안하게 적어 내려가세요.
              </p>
            </div>

            <!-- 미리보기 전환 버튼 -->
            <div class="flex items-center gap-1 bg-stone-100 dark:bg-stone-800 p-1 rounded-lg text-xs font-serif">
              <button
                type="button"
                id="btn-tab-write"
                class="px-2.5 py-1 rounded-md font-medium bg-white dark:bg-stone-700 text-stone-900 dark:text-stone-100 shadow-2xs"
              >
                편집기
              </button>
              <button
                type="button"
                id="btn-tab-preview"
                class="px-2.5 py-1 rounded-md font-medium text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200"
              >
                미리보기
              </button>
            </div>
          </div>

          <!-- 서식 빠른 삽입 툴바 -->
          <div class="flex flex-wrap gap-1 pb-1 border-b border-stone-100 dark:border-stone-800 text-xs">
            <button type="button" data-md="## " class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800 font-bold" title="소제목">H2</button>
            <button type="button" data-md="### " class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800 font-semibold" title="작은 제목">H3</button>
            <button type="button" data-md="**텍스트**" class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800 font-bold" title="굵게">B</button>
            <button type="button" data-md="*텍스트*" class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800 italic" title="기울임">I</button>
            <button type="button" data-md="> " class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800" title="인용문">인용</button>
            <button type="button" data-md="---" class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800" title="구분선">선</button>
            <button type="button" data-md="![설명](사진파일명.webp)" class="btn-md-insert px-2 py-1 rounded hover:bg-stone-100 dark:hover:bg-stone-800 text-forest-700 dark:text-forest-400" title="사진 삽입">📷 사진</button>
          </div>

          <!-- 본문 입력 영역 -->
          <div id="content-write-wrapper">
            <textarea
              id="input-content"
              rows="12"
              placeholder="계절의 문턱이 바뀌는 순간은 늘 발끝에서 먼저 느껴진다..."
              class="w-full p-4 text-sm sm:text-base font-serif leading-relaxed rounded-xl bg-stone-50 dark:bg-stone-800/60 border border-stone-200 dark:border-stone-700 text-stone-900 dark:text-stone-100 focus:ring-2 focus:ring-forest-500/50 outline-none resize-y min-h-64"
            ></textarea>
            <div class="flex justify-between items-center text-xs text-stone-400 font-mono mt-1 px-1">
              <span>글자 수: <span id="char-count">0</span>자</span>
              <span>단락: <span id="para-count">0</span>개</span>
            </div>
          </div>

          <!-- 실시간 마크다운 미리보기 영역 -->
          <div id="content-preview-wrapper" class="hidden min-h-64 p-5 rounded-xl bg-stone-50 dark:bg-stone-800/40 border border-stone-200 dark:border-stone-700 prose prose-stone dark:prose-invert font-serif max-w-none">
            <!-- 미리보기 렌더링 영역 -->
          </div>
        </div>

        <!-- 4. 사진 및 커버 설정 (선택 사항) -->
        <div id="section-photo-settings" class="bg-white/90 dark:bg-stone-900/90 backdrop-blur-md p-5 sm:p-6 rounded-2xl border border-stone-200/80 dark:border-stone-800 shadow-sm space-y-4">
          <div class="border-b border-stone-100 dark:border-stone-800/80 pb-3">
            <h2 class="text-base font-serif font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2">
              <Layers class="w-4 h-4 text-forest-600 dark:text-forest-400" />
              <span>4. 사진 폴더 및 캡션 설정 (선택)</span>
            </h2>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">
              구글 드라이브 동기화 폴더명과 대표 커버 사진을 지정합니다.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="input-photo-folder" class="block text-xs font-serif font-medium text-stone-700 dark:text-stone-300 mb-1">
                사진 폴더명
              </label>
              <input
                type="text"
                id="input-photo-folder"
