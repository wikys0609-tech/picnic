---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { baseUrl } from '@/lib/utils/url';
import { Compass, House } from '@lucide/astro';
---

<BaseLayout title="길을 잃었습니다 (404)">
  <div class="max-w-md mx-auto px-4 py-24 sm:py-32 text-center">
    <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-terracotta-50 dark:bg-night-900 border border-terracotta-100 dark:border-terracotta-800/40 flex items-center justify-center text-terracotta-500">
      <Compass class="w-8 h-8 animate-pulse" />
    </div>

    <span class="text-xs font-semibold uppercase tracking-widest text-terracotta-600 dark:text-terracotta-100">
      404 Not Found
    </span>

    <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-900 dark:text-paper-100">
      길을 잃으셨나요?
    </h1>

    <p class="mt-3 text-sm text-ink-600 dark:text-ink-400 font-sans leading-relaxed">
      찾으시는 페이지가 이동되었거나 존재하지 않는 길입니다.<br />
      익숙하고 평온한 홈으로 다시 발걸음을 옮겨보세요.
    </p>

    <div class="mt-8">
      <a
        href={baseUrl('/')}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-terracotta-500 hover:bg-terracotta-600 text-sm font-semibold text-white transition-colors shadow-sm"
      >
        <House class="w-4 h-4" />
        홈으로 돌아가기
      </a>
    </div>
  </div>
</BaseLayout>
