---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConquestMap from '@/components/map/ConquestMap.astro';
import { calculateConquestStats } from '@/lib/geo/conquest-calc';
import { baseUrl } from '@/lib/utils/url';
import {
  Trophy,
  Compass,
  CircleCheck,
  Search,
  Bookmark,
  ArrowRight,
  ChevronRight,
  Check,
  Map,
} from '@lucide/astro';

// 1. GeoJSON 로드 (경계 피처 개수 기반 동적 계산)
const geoJsonPath = path.resolve(process.cwd(), 'public/geo/metropolitan-83.geojson');
const geoJson = JSON.parse(fs.readFileSync(geoJsonPath, 'utf8'));

// 2. 장소 및 산책 컬렉션 로드
const places = await getCollection('places');
const walks = await getCollection('walks', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// 3. 통계 산출
const stats = calculateConquestStats(geoJson, places, walks);
const mostRecent = stats.mostRecentDistrict;
---

<BaseLayout
  title="수도권 83개 구·시·군 정복 지도"
  description="걸음이 머문 자리마다 숲속 도서관의 탐방 도장이 찍힙니다. 수도권 83개 구역 정복 여정"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-12">
    <!-- 헤더 섹션 -->
    <header class="text-center sm:text-left space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-forest-100/90 dark:bg-forest-950/80 text-forest-800 dark:text-forest-200 text-xs font-serif font-medium border border-forest-200/80 dark:border-forest-800 shadow-xs">
        <Trophy class="w-3.5 h-3.5 text-amber-500 shrink-0" />
        <span>숲 속의 산책 도서관 · 발걸음 탐방 여권</span>
        <span class="opacity-40">·</span>
        <span class="font-sans font-bold text-forest-900 dark:text-forest-100">{stats.conqueredCount} / {stats.totalDistricts} 구역</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-stone-900 dark:text-paper-100 leading-tight">
        발걸음으로 채워가는 수도권 지도
      </h1>

      <p class="font-serif text-sm sm:text-base text-stone-600 dark:text-stone-300 max-w-3xl leading-relaxed">
        걸음이 머문 자리마다 숲속 도서관의 탐방 도장이 찍힙니다.<br class="hidden sm:inline" />
        서울 25개 자치구, 경기 47개 구·시·군(일반구 세분화), 인천 11개 자치구·군(2026 개편) 총 {stats.totalDistricts}개 구역을 차곡차곡 누벼갑니다.
      </p>
    </header>

    <!-- 종합 정복률 대시보드 (여권/서가 브리핑 카드) -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white/90 dark:bg-stone-900/90 backdrop-blur-md border border-stone-200/90 dark:border-stone-800 shadow-[0_12px_36px_rgba(0,0,0,0.05)] dark:shadow-[0_12px_36px_rgba(0,0,0,0.5)] space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- 전체 정복 게이지 (좌측) -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-serif font-bold text-stone-500 dark:text-stone-400">수도권 전체 정복률</span>
            <span class="text-xs font-serif font-semibold text-stone-600 dark:text-stone-300">
              {stats.conqueredCount}곳 정복 / {stats.totalDistricts}곳 중
            </span>
          </div>

          <div class="flex items-baseline gap-3">
            <span class="font-serif text-5xl sm:text-6xl font-bold text-[#1E4A2E] dark:text-[#52B77B] tracking-tight">
              {stats.conquestRate}%
            </span>
            <span class="font-serif text-xs text-stone-400 dark:text-stone-500 leading-tight">
              {stats.totalDistricts - stats.conqueredCount}개 구역의<br />새로운 길이 기다립니다
            </span>
          </div>

          <!-- 프로그레스 바 -->
          <div class="w-full bg-stone-100 dark:bg-stone-800 h-3.5 rounded-full overflow-hidden p-0.5 border border-stone-200 dark:border-stone-700">
            <div
              class="h-full rounded-full transition-all duration-1000 shadow-xs"
              style={`width: ${Math.max(stats.conquestRate, 3)}%; background: linear-gradient(90deg, #1E4A2E 0%, #2E5D3E 70%, #F59E0B 100%);`}
            ></div>
          </div>
        </div>

        <!-- 3대 시·도별 현황 카드 (우측) -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-3">
          <!-- 서울특별시 -->
          <div class="p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-800/60 border border-stone-200/70 dark:border-stone-700/60 space-y-1.5">
            <div class="flex items-center justify-between text-xs font-serif">
              <span class="font-bold text-stone-800 dark:text-stone-200">서울특별시</span>
              <span class="text-[11px] font-sans font-semibold text-forest-700 dark:text-forest-400">
                {stats.sidoStats.seoul.rate}%
              </span>
            </div>
            <div class="font-serif text-xl font-bold text-stone-900 dark:text-paper-100">
              {stats.sidoStats.seoul.conquered} <span class="text-xs font-normal text-stone-500 dark:text-stone-400">/ {stats.sidoStats.seoul.total}구</span>
            </div>
            <div class="w-full bg-stone-200 dark:bg-stone-700 h-1.5 rounded-full overflow-hidden">
              <div class="bg-forest-600 dark:bg-forest-400 h-full rounded-full" style={`width: ${stats.sidoStats.seoul.rate}%`}></div>
            </div>
          </div>

          <!-- 경기도 -->
          <div class="p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-800/60 border border-stone-200/70 dark:border-stone-700/60 space-y-1.5">
            <div class="flex items-center justify-between text-xs font-serif">
              <span class="font-bold text-stone-800 dark:text-stone-200">경기도</span>
              <span class="text-[11px] font-sans font-semibold text-forest-700 dark:text-forest-400">
                {stats.sidoStats.gyeonggi.rate}%
              </span>
            </div>
            <div class="font-serif text-xl font-bold text-stone-900 dark:text-paper-100">
              {stats.sidoStats.gyeonggi.conquered} <span class="text-xs font-normal text-stone-500 dark:text-stone-400">/ {stats.sidoStats.gyeonggi.total}구·군</span>
            </div>
            <div class="w-full bg-stone-200 dark:bg-stone-700 h-1.5 rounded-full overflow-hidden">
              <div class="bg-forest-600 dark:bg-forest-400 h-full rounded-full" style={`width: ${stats.sidoStats.gyeonggi.rate}%`}></div>
            </div>
          </div>

          <!-- 인천광역시 -->
          <div class="p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-800/60 border border-stone-200/70 dark:border-stone-700/60 space-y-1.5">
            <div class="flex items-center justify-between text-xs font-serif">
              <span class="font-bold text-stone-800 dark:text-stone-200">인천광역시</span>
              <span class="text-[11px] font-sans font-semibold text-forest-700 dark:text-forest-400">
                {stats.sidoStats.incheon.rate}%
              </span>
            </div>
            <div class="font-serif text-xl font-bold text-stone-900 dark:text-paper-100">
              {stats.sidoStats.incheon.conquered} <span class="text-xs font-normal text-stone-500 dark:text-stone-400">/ {stats.sidoStats.incheon.total}구·군</span>
            </div>
            <div class="w-full bg-stone-200 dark:bg-stone-700 h-1.5 rounded-full overflow-hidden">
              <div class="bg-forest-600 dark:bg-forest-400 h-full rounded-full" style={`width: ${stats.sidoStats.incheon.rate}%`}></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 하단 서브 그리드: 경기 31개 시·군 현황 & 최근 정복 하이라이트 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 pt-6 border-t border-stone-200/80 dark:border-stone-800">
        <!-- 경기 31개 시·군 발자취 브리핑 -->
        <div class="lg:col-span-7 p-4 sm:p-5 rounded-2xl bg-[#FAF8F5]/80 dark:bg-stone-800/40 border border-stone-200/70 dark:border-stone-800 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Compass class="w-4 h-4 text-forest-700 dark:text-forest-400" />
              <h3 class="font-serif text-sm font-bold text-stone-900 dark:text-stone-100">
                경기 31개 시·군 단위 발자취
              </h3>
            </div>
            <span class="text-xs font-serif text-forest-800 dark:text-forest-300 font-semibold">
              {stats.gyeonggiCityStats.conqueredCities} / {stats.gyeonggiCityStats.totalCities} 시·군 ({stats.gyeonggiCityStats.rate}%)
            </span>
          </div>

          <p class="text-xs text-stone-500 dark:text-stone-400 font-serif leading-relaxed">
            경기도는 24개 일반구(수원·성남·안양·안산·고양·용인·부천·화성)와 23개 시·군을 아우릅니다. 시·군 단위로 발길이 닿은 지역들을 한눈에 확인하세요.
          </p>

          <!-- 31개 시·군 칩 클라우드 -->
          <div class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto pr-1">
            {stats.gyeonggiCityStats.cities.map((city) => (
              <span
                class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-serif transition-colors ${
                  city.isConquered
                    ? 'bg-[#1E4A2E]/10 text-[#1E4A2E] dark:bg-[#2E5D3E]/30 dark:text-[#84D4A3] font-bold border border-[#1E4A2E]/20 dark:border-[#2E5D3E]/40'
                    : 'bg-stone-100/70 text-stone-400 dark:bg-stone-800/50 dark:text-stone-500 border border-stone-200/60 dark:border-stone-800'
                }`}
                title={city.districtsCount > 1 ? `${city.name} (${city.conqueredCount}/${city.districtsCount}개 일반구)` : city.name}
              >
                {city.isConquered && <Check class="w-3 h-3 text-[#1E4A2E] dark:text-[#84D4A3]" />}
                <span>{city.name}</span>
                {city.districtsCount > 1 && (
                  <span class="text-[9.5px] opacity-70">
                    ({city.conqueredCount}/{city.districtsCount})
                  </span>
                )}
              </span>
            ))}
          </div>
        </div>

        <!-- 가장 최근 정복한 구역 하이라이트 -->
        <div class="lg:col-span-5 p-4 sm:p-5 rounded-2xl bg-gradient-to-br from-amber-500/10 via-amber-400/5 to-transparent dark:from-amber-950/30 dark:via-stone-800/40 dark:to-transparent border border-amber-300/60 dark:border-amber-700/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="silk-ribbon w-2.5 h-4 bg-amber-500 rounded-xs shadow-xs"></span>
              <span class="text-[11px] font-serif font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
                가장 최근 정복한 구역
              </span>
            </div>

            {mostRecent ? (
              <div class="space-y-2 mt-1">
                <div class="flex items-baseline gap-2">
                  <h4 class="font-serif text-xl sm:text-2xl font-bold text-stone-900 dark:text-paper-100">
                    {mostRecent.sido} {mostRecent.name}
                  </h4>
                  {mostRecent.latestVisitDate && (
                    <span class="text-xs text-stone-500 dark:text-stone-400 font-serif">
                      ({mostRecent.latestVisitDate})
                    </span>
                  )}
                </div>

                <p class="text-xs text-stone-600 dark:text-stone-400 font-serif leading-relaxed line-clamp-2">
                  수록 산책 <strong>{mostRecent.walkCount}편</strong> · 탐방 장소: {mostRecent.places.map((p) => p.data.name).join(', ')}
                </p>
              </div>
            ) : (
              <p class="text-xs text-stone-500 dark:text-stone-400 font-serif mt-2">
                아직 정복한 구역이 없습니다. 첫 산책을 기록해보세요!
              </p>
            )}
          </div>

          {mostRecent && mostRecent.places.length > 0 && (
            <div class="mt-4 pt-3 border-t border-amber-200/60 dark:border-amber-800/40 flex items-center justify-between">
              <span class="text-xs font-serif text-amber-900 dark:text-amber-200">
                📖 서가에 꽂힌 앨범 바로 열기
              </span>
              <a
                href={baseUrl(`/places/${mostRecent.places[0].id}`)}
                class="inline-flex items-center gap-1 text-xs font-serif font-bold text-[#1E4A2E] dark:text-amber-300 hover:underline"
              >
                <span>{mostRecent.places[0].data.name} 앨범</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- 인터랙티브 정복 지도 컴포넌트 -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-stone-900 dark:text-paper-100 flex items-center gap-2">
          <Map class="w-5 h-5 text-forest-700 dark:text-forest-400" />
          <span>수도권 전도 (全圖) 탐방 지도</span>
        </h2>
        <span class="text-xs font-serif text-stone-500 dark:text-stone-400 hidden sm:inline">
          구역을 클릭하면 수록된 산책 앨범과 발자취를 확인할 수 있습니다
        </span>
      </div>

      <ConquestMap geoJson={geoJson} stats={stats} />
    </section>

    <!-- 83개 구역 탐방 도장첩 & 체크리스트 (Passport Stamps Grid) -->
    <section class="space-y-6 pt-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-serif font-bold text-forest-800 dark:text-forest-300 mb-1">
            <Bookmark class="w-3.5 h-3.5 text-amber-500" />
            <span>수도권 83개 구·시·군 전 구역 탐방첩</span>
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 dark:text-paper-100">
            도장으로 채워진 서가의 책장
          </h2>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 font-serif mt-1">
            정복을 마친 구역에는 탐방 도장이 날인되며, 해당 지역의 장소 앨범으로 바로 이동할 수 있습니다.
          </p>
        </div>

        <!-- 검색창 -->
        <div class="relative w-full md:w-72">
          <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" />
          <input
            type="text"
            id="district-search-input"
            placeholder="구역명 검색 (예: 성동구, 분당, 수원...)"
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-xs font-serif text-stone-900 dark:text-paper-100 placeholder:text-stone-400 focus:outline-none focus:border-forest-600 dark:focus:border-forest-400 shadow-xs"
          />
        </div>
      </div>

      <!-- 필터 탭 -->
      <div class="flex flex-wrap items-center gap-1.5 border-b border-stone-200 dark:border-stone-800 pb-3" id="district-grid-tabs">
        <button
          type="button"
          class="grid-tab-btn active px-3.5 py-1.5 rounded-xl text-xs font-serif font-bold bg-[#1E4A2E] text-white shadow-xs transition-colors"
          data-tab="all"
        >
          전체 ({stats.totalDistricts})
        </button>
        <button
          type="button"
          class="grid-tab-btn px-3 py-1.5 rounded-xl text-xs font-serif font-medium bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors"
          data-tab="서울특별시"
        >
          서울 ({stats.sidoStats.seoul.conquered}/{stats.sidoStats.seoul.total})
        </button>
        <button
          type="button"
          class="grid-tab-btn px-3 py-1.5 rounded-xl text-xs font-serif font-medium bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors"
          data-tab="경기도"
        >
          경기 ({stats.sidoStats.gyeonggi.conquered}/{stats.sidoStats.gyeonggi.total})
        </button>
        <button
          type="button"
          class="grid-tab-btn px-3 py-1.5 rounded-xl text-xs font-serif font-medium bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors"
          data-tab="인천광역시"
        >
          인천 ({stats.sidoStats.incheon.conquered}/{stats.sidoStats.incheon.total})
        </button>
        <button
          type="button"
          class="grid-tab-btn px-3 py-1.5 rounded-xl text-xs font-serif font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800 hover:bg-emerald-100 transition-colors ml-auto"
          data-tab="conquered"
        >
          ✓ 정복 완료만 ({stats.conqueredCount})
        </button>
        <button
          type="button"
          class="grid-tab-btn px-3 py-1.5 rounded-xl text-xs font-serif font-medium bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400 hover:bg-stone-200 transition-colors"
          data-tab="unvisited"
        >
          미답사 ({stats.totalDistricts - stats.conqueredCount})
        </button>
      </div>

      <!-- 83개 구역 카드 그리드 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5" id="district-grid-container">
        {stats.districtsList.map((district) => {
          const isConquered = district.isConquered;
          const data = district.conqueredData;
          const shortName = district.sigungu.split(' ').pop() || district.name;

          return (
            <div
              class={`district-card relative p-4 rounded-2xl border transition-all duration-200 flex flex-col justify-between ${
                isConquered
                  ? 'bg-white dark:bg-stone-900 border-stone-200 dark:border-stone-800 shadow-xs hover:border-[#1E4A2E] dark:hover:border-forest-500'
                  : 'bg-stone-50/70 dark:bg-stone-900/40 border-dashed border-stone-200/90 dark:border-stone-800/80 opacity-75 hover:opacity-100'
              }`}
              data-id={district.id}
              data-sido={district.sido}
              data-name={district.name}
              data-sigungu={district.sigungu}
              data-conquered={isConquered ? 'true' : 'false'}
            >
              <div>
                <!-- 카드 상단: 시도 뱃지 & 스탬프 인장 -->
                <div class="flex items-start justify-between gap-2 mb-2.5">
                  <div class="space-y-0.5">
                    <span class="text-[10px] font-serif text-stone-400 dark:text-stone-500 block">
                      {district.sido}
                    </span>
                    <h3 class="font-serif text-base font-bold text-stone-900 dark:text-paper-100 leading-snug">
                      {district.name}
                    </h3>
                  </div>

                  <!-- 도장 인장 (Stamp) UI -->
                  {isConquered ? (
                    <div class="relative shrink-0 flex items-center justify-center w-11 h-11 rounded-full border-2 border-[#1E4A2E] dark:border-[#3D6B4F] bg-[#FAF8F5] dark:bg-[#1A1816] shadow-xs rotate-[-6deg]">
                      <div class="w-9 h-9 rounded-full border border-dashed border-[#2E5D3E] dark:border-[#4E8062] flex flex-col items-center justify-center text-center p-0.5">
                        <span class="text-[8px] font-serif font-bold text-[#1E4A2E] dark:text-[#E2EBE5] leading-none truncate max-w-[30px]">
                          {shortName}
                        </span>
                        <span class="text-[6.5px] font-serif font-bold text-amber-700 dark:text-amber-400 leading-none mt-0.5">
                          탐방
                        </span>
                      </div>
                    </div>
                  ) : (
                    <div class="shrink-0 flex items-center justify-center w-11 h-11 rounded-full border border-dashed border-stone-300 dark:border-stone-700 text-stone-300 dark:text-stone-600 text-[10px] font-serif">
                      <span>미답</span>
                    </div>
                  )}
                </div>

                <!-- 내용 요약 -->
                {isConquered && data ? (
                  <div class="space-y-2 mt-3 pt-2.5 border-t border-stone-100 dark:border-stone-800">
                    <div class="flex items-center justify-between text-[11px] font-serif text-stone-500 dark:text-stone-400">
                      <span>수록 산책: <strong class="text-stone-800 dark:text-paper-200">{data.walkCount}편</strong></span>
                      {data.latestVisitDate && <span>최근: {data.latestVisitDate.slice(5)}</span>}
                    </div>

                    <!-- 장소 앨범 링크 칩 -->
                    <div class="space-y-1">
                      {data.places.map((place) => (
                        <a
                          href={baseUrl(`/places/${place.id}`)}
                          class="group/link flex items-center justify-between px-2 py-1 rounded-lg bg-stone-100/80 dark:bg-stone-800 hover:bg-forest-50 dark:hover:bg-forest-950/40 text-stone-800 dark:text-stone-200 transition-colors text-xs font-serif"
                        >
                          <span class="truncate max-w-[140px] group-hover/link:text-[#1E4A2E] dark:group-hover/link:text-forest-300">
                            📖 {place.data.name}
                          </span>
                          <ChevronRight class="w-3 h-3 text-stone-400 group-hover/link:translate-x-0.5 transition-transform shrink-0" />
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <p class="text-[11px] text-stone-400 dark:text-stone-500 font-serif leading-relaxed mt-2 pt-2 border-t border-stone-100 dark:border-stone-800/60">
                    아직 발걸음이 닿지 않은 구역입니다. 다음 산책 목적지로 삼아보세요.
                  </p>
                )}
              </div>

              <!-- 하단 상태 칩 -->
              <div class="mt-3 pt-2 flex items-center justify-between text-[10.5px] font-serif">
                {isConquered ? (
                  <span class="inline-flex items-center gap-1 text-[#1E4A2E] dark:text-[#84D4A3] font-bold">
                    <CircleCheck class="w-3 h-3" />
                    <span>정복 완료</span>
                  </span>
                ) : (
                  <span class="text-stone-400 dark:text-stone-500">
                    미답사 구역
                  </span>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <!-- 검색 결과 없음 알림 -->
      <div id="district-empty-msg" class="hidden py-12 text-center space-y-2">
        <p class="font-serif text-stone-600 dark:text-stone-400 text-sm">
          검색 조건과 일치하는 구역이 없습니다.
        </p>
        <button
          type="button"
          id="district-clear-search"
          class="text-xs font-serif text-forest-700 dark:text-forest-400 underline hover:text-forest-900"
        >
          검색어 초기화
        </button>
      </div>
    </section>

    <!-- 각주 및 데이터 출처 안내 -->
    <footer class="p-6 rounded-2xl bg-[#FAF8F5] dark:bg-stone-900/60 border border-stone-200/80 dark:border-stone-800 text-xs font-serif text-stone-500 dark:text-stone-400 space-y-2 leading-relaxed">
      <h4 class="font-bold text-stone-800 dark:text-stone-200 flex items-center gap-1.5">
        <span>🗺️ 수도권 83개 구·시·군 행정구역 및 경계 데이터 기준</span>
      </h4>
      <ul class="list-disc list-inside space-y-1 pl-1">
        <li>
          <strong>서울특별시 (25개)</strong>: 25개 자치구 전체
        </li>
        <li>
          <strong>인천광역시 (11개)</strong>: 2026년 7월 1일 출범 예정인 신설 행정구역 개편(제물포구, 영종구, 검단구, 서해구 및 기존 7개 구·군) 선제 반영
        </li>
        <li>
          <strong>경기도 (47개)</strong>: 8개 대도시의 24개 일반구(수원 4, 성남 3, 안양 2, 안산 2, 고양 3, 용인 3, 부천 3, 화성 4) 및 일반구가 없는 23개 시·군
        </li>
        <li>
          <strong>경계 데이터 출처</strong>: 대한민국 통계청/행정안전부 행정동 경계 오픈소스(raqoon886/Local_HangJeongDong). 내부 행정동 경선을 Turf.js로 결합(Dissolve)하고 0.0008° 단순화하여 웹 지도의 쾌적한 반응 속도를 확보했습니다.
        </li>
      </ul>
    </footer>
  </div>
</BaseLayout>

<script>
  function setupDistrictGridFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.grid-tab-btn');
    const searchInput = document.getElementById('district-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.district-card');
    const emptyMsg = document.getElementById('district-empty-msg');
    const clearBtn = document.getElementById('district-clear-search');

    let currentTab = 'all';
    let currentQuery = '';

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const sido = card.dataset.sido || '';
        const name = card.dataset.name || '';
        const sigungu = card.dataset.sigungu || '';
        const isConquered = card.dataset.conquered === 'true';

        // 1. 탭 필터
        let matchesTab = true;
        if (currentTab === '서울특별시' || currentTab === '경기도' || currentTab === '인천광역시') {
          matchesTab = sido === currentTab;
        } else if (currentTab === 'conquered') {
          matchesTab = isConquered;
        } else if (currentTab === 'unvisited') {
          matchesTab = !isConquered;
        }

        // 2. 검색어 필터
        let matchesQuery = true;
        if (currentQuery) {
          const q = currentQuery.toLowerCase();
          matchesQuery = name.toLowerCase().includes(q) || sigungu.toLowerCase().includes(q) || sido.toLowerCase().includes(q);
        }

        if (matchesTab && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyMsg) {
        if (visibleCount === 0) {
          emptyMsg.classList.remove('hidden');
        } else {
          emptyMsg.classList.add('hidden');
        }
      }
    }

    tabs.forEach((tab) => {
      tab.onclick = () => {
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-[#1E4A2E]', 'text-white');
          if (t.dataset.tab === 'conquered') {
            t.classList.add('bg-emerald-50', 'dark:bg-emerald-950/40', 'text-emerald-800', 'dark:text-emerald-300');
          } else {
            t.classList.add('bg-stone-100', 'dark:bg-stone-800', 'text-stone-700', 'dark:text-stone-300');
          }
        });

        tab.classList.add('active', 'bg-[#1E4A2E]', 'text-white');
        tab.classList.remove('bg-stone-100', 'dark:bg-stone-800', 'text-stone-700', 'dark:text-stone-300', 'bg-emerald-50', 'text-emerald-800');

        currentTab = tab.dataset.tab || 'all';
        applyFilters();
      };
    });

    if (searchInput) {
      searchInput.oninput = (e) => {
        currentQuery = (e.target as HTMLInputElement).value.trim();
        applyFilters();
      };
    }

    if (clearBtn && searchInput) {
      clearBtn.onclick = () => {
        searchInput.value = '';
        currentQuery = '';
        applyFilters();
      };
    }
  }

  setupDistrictGridFilters();
  document.addEventListener('astro:after-swap', setupDistrictGridFilters);
</script>
