---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WalkCard from '@/components/walk/WalkCard.astro';
import Badge from '@/components/ui/Badge.astro';
import { baseUrl } from '@/lib/utils/url';
import { Footprints, ArrowLeft, Lightbulb } from '@lucide/astro';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({
    params: { id: place.slug || place.id.replace(/\.md$/, '') },
    props: { place },
  }));
}

const { place } = Astro.props;
const { name, sido, sigungu, type, facilities, tips } = place.data;

// 이 장소를 방문한 모든 산책 기록 조회
const allWalks = await getCollection('walks', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const relatedWalks = allWalks.filter((walk) =>
  walk.data.places.some((p) => p.id === place.id)
);
relatedWalks.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const { Content } = await place.render();
---

<BaseLayout title={name} description={`${sido} ${sigungu}의 ${type} - ${name} 산책 정보`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <div class="mb-8">
      <a
        href={baseUrl('/map')}
        class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-500 hover:text-terracotta-600 dark:text-ink-400 dark:hover:text-terracotta-100 transition-colors"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        장소 목록으로 돌아가기
      </a>
    </div>

    <!-- 헤더 -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-forest-700 dark:text-forest-100 bg-forest-50 dark:bg-night-800 px-2.5 py-1 rounded-md">
          {type}
        </span>
        <span class="text-xs text-ink-400">
          {sido} {sigungu}
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 dark:text-paper-100">
        {name}
      </h1>
    </header>

    <!-- 장소 소개 본문 -->
    <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-night-900 border border-paper-200 dark:border-night-800 mb-8 shadow-sm">
      <div class="prose prose-essay max-w-none text-ink-800 dark:text-paper-200 font-sans mb-6">
        <Content />
      </div>

      <!-- 방문 팁 -->
      {tips && (
        <div class="flex items-start gap-3 p-4 rounded-xl bg-paper-100/80 dark:bg-night-800 text-xs sm:text-sm text-ink-700 dark:text-paper-300">
          <Lightbulb class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
          <div>
            <strong class="font-semibold text-ink-900 dark:text-paper-100">산책 팁:</strong> {tips}
          </div>
        </div>
      )}

      <!-- 편의시설 태그 -->
      {facilities && facilities.length > 0 && (
        <div class="mt-6 pt-4 border-t border-paper-100 dark:border-night-800 flex flex-wrap items-center gap-1.5">
          <span class="text-xs text-ink-400 mr-1">시설 및 특징:</span>
          {facilities.map((facility) => (
            <Badge variant="muted" size="sm">
              {facility}
            </Badge>
          ))}
        </div>
      )}
    </div>

    <!-- 이 장소를 방문한 산책 기록들 -->
    <section class="mt-12">
      <div class="flex items-center gap-2 mb-6">
        <Footprints class="w-5 h-5 text-terracotta-500" />
        <h2 class="font-serif text-xl font-bold text-ink-900 dark:text-paper-100">
          이곳을 걸었던 기록들 ({relatedWalks.length}회)
        </h2>
      </div>

      {relatedWalks.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedWalks.map((walk) => (
            <WalkCard walk={walk} />
          ))}
        </div>
      ) : (
        <p class="text-sm text-ink-500 py-6">아직 작성된 산책 기록이 없습니다.</p>
      )}
    </section>
  </div>
</BaseLayout>
