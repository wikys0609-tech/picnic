---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceMap from '@/components/map/PlaceMap.astro';
import ScrapbookGallery from '@/components/album/ScrapbookGallery.astro';
import Badge from '@/components/ui/Badge.astro';
import { baseUrl } from '@/lib/utils/url';
import { formatDateKorean } from '@/lib/utils/date';
import type { MapPlace } from '@/lib/map/types';
import {
  ArrowLeft,
  Calendar,
  Clock,
  CloudSun,
  Users,
  Footprints,
  Lightbulb,
  Compass,
  Bookmark,
  ExternalLink,
  BookOpen,
} from '@lucide/astro';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({
    params: { id: place.id },
    props: { place },
  }));
}

const { place } = Astro.props;
const { name, sido, sigungu, type, facilities, tips } = place.data;

// 전체 장소 맵 (크로스 앨범 링크 검색용)
const allPlaces = await getCollection('places');
const placeLookup = new Map(allPlaces.map((p) => [p.id, p]));

// 카카오 지도 어댑터용 데이터
const mapPlace: MapPlace = {
  id: place.id,
  name: place.data.name,
  lat: place.data.lat,
  lng: place.data.lng,
  sido: place.data.sido,
  sigungu: place.data.sigungu,
  type: place.data.type,
  facilities: place.data.facilities,
  tips: place.data.tips,
  hidden: place.data.hidden,
};

// 이 장소를 방문한 산책 기록 조회 (최신순)
const allWalks = await getCollection('walks', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const relatedWalks = allWalks.filter((walk) =>
  walk.data.places.some((p) => p.id === place.id)
);
relatedWalks.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// 각 산책의 본문 렌더링 및 동행 장소 매핑
const renderedWalks = await Promise.all(
  relatedWalks.map(async (walk, index) => {
    const rendered = await render(walk);
    const companionPlaces = walk.data.places
      .filter((p) => p.id !== place.id)
      .map((p) => placeLookup.get(p.id))
      .filter(Boolean);

    return {
      walk,
      chapterNumber: relatedWalks.length - index,
      renderedContent: rendered.Content,
      companionPlaces,
    };
  })
);

// 장소 소개 본문
const { Content: PlaceIntro } = await render(place);

const firstVisit = relatedWalks.length > 0 ? relatedWalks[relatedWalks.length - 1].data.date : null;
const latestVisit = relatedWalks.length > 0 ? relatedWalks[0].data.date : null;
---

<BaseLayout
  title={`${name} 앨범`}
  description={`${sido} ${sigungu}의 ${type} - ${name}에 깃든 ${relatedWalks.length}번의 발걸음 기록`}
>
  <!-- 미세 필름 그레인 -->
  <div class="fixed inset-0 pointer-events-none z-40 opacity-[0.02] mix-blend-overlay bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="min-h-screen bg-[#F8F6F0] dark:bg-[#131211] py-8 sm:py-14 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- 상단 내비게이션 바 -->
      <div class="mb-6 flex items-center justify-between">
        <a
          href={baseUrl('/')}
          class="inline-flex items-center gap-2 text-xs font-serif font-medium text-stone-700 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white transition-colors bg-white/80 dark:bg-stone-800/80 backdrop-blur-md px-3.5 py-2 rounded-xl border border-stone-200/80 dark:border-stone-700 shadow-xs"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>서가로 돌아가기</span>
        </a>

        <div class="inline-flex items-center gap-1.5 text-xs text-stone-500 dark:text-stone-400 font-serif">
          <BookOpen class="w-3.5 h-3.5 text-stone-600 dark:text-stone-400" />
          <span>{name} 앨범 · <strong>{relatedWalks.length}편</strong>의 산책 수록</span>
        </div>
      </div>

      <!-- 펼쳐진 앨범 양면 스프레드 컨테이너 (Open Book Spread) -->
      <div class="relative bg-[#FAF8F5] dark:bg-[#1A1816] rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.08)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.6)] border border-stone-200 dark:border-stone-800 overflow-hidden">
        <!-- 책 중앙 바인더 접힘 그림자 (책장을 펼친 듯한 자연스러운 음영) -->
        <div class="absolute inset-0 pointer-events-none book-gutter-shadow z-10 hidden md:block"></div>

        <!-- 앨범 상단 마감 라인 -->
        <div class="h-2 w-full bg-gradient-to-r from-stone-400/40 via-stone-300/30 to-stone-400/40 dark:from-stone-700/40 dark:via-stone-600/30 dark:to-stone-700/40"></div>

        <div class="p-6 sm:p-10 md:p-14 relative z-0">
          <!-- 1. 표지 및 도서 서지 정보 섹션 (Front Matter) -->
          <section id="cover" class="mb-14 pb-12 border-b border-stone-200 dark:border-stone-800">
            <!-- 메타 칩 -->
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-stone-200/70 text-stone-800 dark:bg-stone-800 dark:text-stone-200 font-sans">
                {type}
              </span>
              <span class="text-xs font-serif text-stone-500 dark:text-stone-400">
                {sido} {sigungu}
              </span>
            </div>

            <!-- 앨범 제목 (Gowun Batang 대형 타이포그래피) -->
            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-stone-900 dark:text-paper-100 leading-tight mb-4">
              {name}
            </h1>

            <!-- 앨범 서지 통계 칩 -->
            <div class="flex flex-wrap items-center gap-4 text-xs font-serif text-stone-600 dark:text-stone-400 mb-8 bg-white/70 dark:bg-stone-900/60 p-3.5 rounded-xl border border-stone-200/80 dark:border-stone-800">
              <span class="flex items-center gap-1.5">
                <Footprints class="w-4 h-4 text-forest-700 dark:text-forest-400" />
                <span>누적 발걸음: <strong class="text-stone-900 dark:text-paper-100">{relatedWalks.length}회</strong></span>
              </span>
              {firstVisit && (
                <span class="flex items-center gap-1.5">
                  <Calendar class="w-4 h-4 text-terracotta-600 dark:text-terracotta-400" />
                  <span>첫 방문: <strong class="text-stone-900 dark:text-paper-100">{formatDateKorean(firstVisit)}</strong></span>
                </span>
              )}
              {latestVisit && firstVisit !== latestVisit && (
                <span class="flex items-center gap-1.5">
                  <Bookmark class="w-4 h-4 text-amber-500" />
                  <span>최근 방문: <strong class="text-stone-900 dark:text-paper-100">{formatDateKorean(latestVisit)}</strong></span>
                </span>
              )}
            </div>

            <!-- 장소 소개 산문 본문 -->
            <div class="prose prose-essay max-w-none text-stone-800 dark:text-paper-200 mb-8">
              <PlaceIntro />
            </div>

            <!-- 산책 팁 -->
            {tips && (
              <div class="flex items-start gap-3 p-4 rounded-xl bg-amber-50/80 dark:bg-amber-950/20 border border-amber-200/60 dark:border-amber-900/40 text-xs sm:text-sm text-stone-800 dark:text-amber-100 mb-8 font-serif">
                <Lightbulb class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" />
                <div>
                  <strong class="font-semibold text-amber-950 dark:text-amber-200">산책 팁:</strong> {tips}
                </div>
              </div>
            )}

            <!-- 편의시설 태그 -->
            {facilities && facilities.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5 mb-8">
                <span class="text-xs font-serif text-stone-500 dark:text-stone-400 mr-1">편의 및 시설:</span>
                {facilities.map((facility) => (
                  <Badge variant="muted" size="sm">
                    {facility}
                  </Badge>
                ))}
              </div>
            )}

            <!-- 카카오 지도 (정갈한 건축적 프레임) -->
            <div class="mt-6 rounded-xl overflow-hidden border border-stone-200 dark:border-stone-800 shadow-sm">
              <PlaceMap place={mapPlace} />
            </div>
          </section>

          <!-- 책갈피 인덱스 탭 (다회 방문 시 상단 고정 점프 탭) -->
          {renderedWalks.length > 1 && (
            <div class="sticky top-20 z-20 mb-10 py-2.5 -mx-2 px-2 bg-[#FAF8F5]/95 dark:bg-[#1A1816]/95 backdrop-blur-md border-b border-stone-200 dark:border-stone-800 overflow-x-auto hide-scrollbar flex items-center gap-2">
              <span class="text-xs font-serif text-stone-400 shrink-0 flex items-center gap-1 mr-1">
                <Bookmark class="w-3.5 h-3.5 text-amber-500" />
                책갈피:
              </span>
              {renderedWalks.map(({ walk, chapterNumber }) => (
                <a
                  href={`#chapter-${walk.id}`}
                  class="chapter-tab-link shrink-0 text-xs font-serif px-3 py-1.5 rounded-lg bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-700 dark:text-stone-200 hover:text-stone-950 dark:hover:text-white hover:border-amber-400 dark:hover:border-amber-500 transition-colors shadow-xs"
                >
                  제{chapterNumber}장 ({walk.data.date.slice(5)})
                </a>
              ))}
            </div>
          )}

          <!-- 2. 본문: 산책 기록 장(Chapter)들 (최신순 배치) -->
          <div class="space-y-16">
            {renderedWalks.length > 0 ? (
              renderedWalks.map(({ walk, chapterNumber, renderedContent: WalkContent, companionPlaces }) => (
                <article
                  id={`chapter-${walk.id}`}
                  class="chapter-section pt-8 scroll-mt-28 relative"
                >
                  <!-- 챕터 헤더 (에디토리얼 조판) -->
                  <div class="mb-6">
                    <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-stone-200 dark:border-stone-800">
                      <!-- 장 번호 및 날짜 -->
                      <div class="flex items-center gap-2.5">
                        <span class="font-serif text-xs font-bold text-stone-800 dark:text-stone-200 bg-stone-200/80 dark:bg-stone-800 px-2 py-0.5 rounded">
                          제 {chapterNumber} 장
                        </span>
                        <time datetime={walk.data.date} class="font-serif text-sm font-medium text-stone-600 dark:text-stone-300">
                          {formatDateKorean(walk.data.date)}
                        </time>
                      </div>

                      <!-- 기후/기분 메타 -->
                      <div class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400 font-sans">
                        {walk.data.weather && (
                          <span class="inline-flex items-center gap-1">
                            <CloudSun class="w-3.5 h-3.5 text-amber-500" />
                            {walk.data.weather}
                          </span>
                        )}
                        {walk.data.timeOfDay && (
                          <span class="inline-flex items-center gap-1">
                            <Clock class="w-3.5 h-3.5 text-stone-400" />
                            {walk.data.timeOfDay}
                          </span>
                        )}
                        {walk.data.companions && (
                          <span class="inline-flex items-center gap-1">
                            <Users class="w-3.5 h-3.5 text-stone-400" />
                            {walk.data.companions}
                          </span>
                        )}
                        {walk.data.mood && <Badge variant="accent">{walk.data.mood}</Badge>}
                      </div>
                    </div>

                    <!-- 장 제목 -->
                    <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-paper-100 mt-4 leading-snug">
                      {walk.data.title}
                    </h2>
                  </div>

                  <!-- 에세이 본문 (산문집 감성 넉넉한 조판) -->
                  <div class="prose prose-essay max-w-none text-stone-800 dark:text-paper-200 my-6">
                    <WalkContent />
                  </div>

                  <!-- 사진 갤러리 (정갈한 인화 사진 카드 & Nanum Myeongjo 캡션) -->
                  <ScrapbookGallery
                    photoFolder={walk.data.photoFolder}
                    cover={walk.data.cover}
                    captions={walk.data.captions}
                    title={walk.data.title}
                  />

                  <!-- 이 날 함께 들른 다른 장소들 (크로스 앨범 링크) -->
                  {companionPlaces && companionPlaces.length > 0 && (
                    <div class="mt-8 p-5 rounded-xl bg-stone-100/70 dark:bg-stone-900/50 border border-stone-200 dark:border-stone-800">
                      <div class="flex items-center gap-1.5 text-xs font-serif font-bold text-stone-900 dark:text-stone-200 mb-2">
                        <Compass class="w-4 h-4 text-forest-700 dark:text-forest-400" />
                        <span>이 날 함께 들른 곳의 앨범</span>
                      </div>
                      <p class="text-xs text-stone-600 dark:text-stone-400 font-serif mb-3">
                        같은 날 걸음을 나누었던 다른 장소의 책으로 바로 건너갈 수 있습니다.
                      </p>
                      <div class="flex flex-wrap gap-2">
                        {companionPlaces.map((comp) => (
                          comp && (
                            <a
                              href={baseUrl(`/places/${comp.id}`)}
                              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-xs font-serif text-stone-800 dark:text-stone-200 hover:text-stone-950 dark:hover:text-white hover:border-amber-400 dark:hover:border-amber-500 transition-colors shadow-xs"
                            >
                              <span>📖 {comp.data.name}</span>
                              <span class="text-[10px] text-stone-400 font-sans">({comp.data.sigungu})</span>
                              <ExternalLink class="w-3 h-3 text-stone-400" />
                            </a>
                          )
                        ))}
                      </div>
                    </div>
                  )}

                  <!-- 챕터 구분 장식 (정갈한 책 엠블럼) -->
                  <div class="my-12 flex items-center justify-center">
                    <div class="h-px bg-stone-200 dark:bg-stone-800 w-1/3"></div>
                    <span class="px-3 text-stone-300 dark:text-stone-600 font-serif text-xs">❦</span>
                    <div class="h-px bg-stone-200 dark:bg-stone-800 w-1/3"></div>
                  </div>
                </article>
              ))
            ) : (
              /* 아직 방문 기록이 없는 경우의 첫 페이지 */
              <div class="py-16 text-center">
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-stone-200/80 dark:bg-stone-800 flex items-center justify-center text-stone-400">
                  <BookOpen class="w-6 h-6" />
                </div>
                <h3 class="font-serif text-lg font-bold text-stone-800 dark:text-paper-200 mb-2">
                  아직 첫 장이 꽂히지 않은 빈 앨범입니다
                </h3>
                <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 max-w-md mx-auto font-serif">
                  이곳을 걷고 산책 일기를 기록하면 서가의 책등이 두터워지며 첫 번째 장(章)이 채워집니다.
                </p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 전체 화면 라이트박스 모달 -->
  <div
    id="album-lightbox"
    class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <button
      id="album-lightbox-close"
      class="absolute top-4 right-4 p-2 text-white/80 hover:text-white rounded-full bg-white/10 hover:bg-white/20 transition-colors"
      aria-label="닫기"
    >
      <span class="text-2xl font-light leading-none">&times;</span>
    </button>

    <div class="max-w-4xl max-h-[85vh] flex flex-col items-center">
      <img
        id="album-lightbox-img"
        src=""
        alt=""
        class="max-h-[75vh] w-auto max-w-full rounded-lg object-contain shadow-2xl"
      />
      <p id="album-lightbox-caption" class="mt-4 font-caption text-sm sm:text-base text-paper-200 text-center max-w-lg"></p>
    </div>
  </div>
</BaseLayout>

<script>
  import { playPageFlipSound } from '@/lib/sound/library-sounds';

  function setupAlbumInteractions() {
    // 책갈피 탭 클릭 시 책장 넘김 효과음
    const tabLinks = document.querySelectorAll('.chapter-tab-link');
    tabLinks.forEach((link) => {
      link.addEventListener('click', () => {
        playPageFlipSound();
      });
    });

    // 라이트박스 모달 바인딩
    const modal = document.getElementById('album-lightbox');
    const closeBtn = document.getElementById('album-lightbox-close');
    const modalImg = document.getElementById('album-lightbox-img') as HTMLImageElement | null;
    const modalCaption = document.getElementById('album-lightbox-caption');
    const buttons = document.querySelectorAll('.scrapbook-img-btn');

    if (!modal || !closeBtn || !modalImg || !modalCaption) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img-src') || '';
        const cap = btn.getAttribute('data-caption') || '';
        modalImg.src = src;
        modalCaption.textContent = cap;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      modal?.classList.remove('flex');
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (modalImg) modalImg.src = '';
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  setupAlbumInteractions();
  document.addEventListener('astro:after-swap', setupAlbumInteractions);
</script>
