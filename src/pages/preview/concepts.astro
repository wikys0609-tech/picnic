<script>
  function setupConceptSwitcher() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.concept-tab-btn');
    const sections = document.querySelectorAll<HTMLElement>('.concept-section');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.target;
        if (!targetId) return;

        // 탭 스타일 전환
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-amber-600/90', 'text-white', 'shadow-md');
          t.classList.add('text-neutral-300');
        });
        tab.classList.add('active', 'bg-amber-600/90', 'text-white', 'shadow-md');
        tab.classList.remove('text-neutral-300');

        // 섹션 전환
        sections.forEach((sec) => {
          if (sec.id === targetId) {
            sec.classList.remove('hidden');
            sec.classList.add('block');
          } else {
            sec.classList.remove('block');
            sec.classList.add('hidden');
          }
        });
      });
    });
  }

  setupConceptSwitcher();
  document.addEventListener('astro:after-swap', setupConceptSwitcher);
</script>
