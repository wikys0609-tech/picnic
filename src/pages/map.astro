---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MapView from '@/components/map/MapView.astro';
import Badge from '@/components/ui/Badge.astro';
import { baseUrl } from '@/lib/utils/url';
import type { MapPlace } from '@/lib/map/types';
import { Map, MapPin } from '@lucide/astro';

const places = await getCollection('places');
const allWalks = await getCollection('walks', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// 지도용 장소 데이터 및 방문 산책 기록 매핑
const mapPlaces: MapPlace[] = places.map((place) => {
  const relatedWalks = allWalks.filter((walk) =>
    walk.data.places.some((p) => p.id === place.id)
  );

  return {
    id: place.id,
    name: place.data.name,
    lat: place.data.lat,
    lng: place.data.lng,
    sido: place.data.sido,
    sigungu: place.data.sigungu,
    type: place.data.type,
    facilities: place.data.facilities,
    tips: place.data.tips,
    hidden: place.data.hidden,
    walks: relatedWalks.map((w) => ({
      id: w.id,
      title: w.data.title,
      date: w.data.date,
    })),
  };
});
---

<BaseLayout title="도서관 장소 지도" description="도서관 벽에 걸린 수도권 산책 장소 지도">
  <div class="library-sunlight min-h-screen py-10 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <header class="mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-forest-100/80 dark:bg-forest-950 text-forest-800 dark:text-forest-200 text-xs font-serif font-medium mb-3 border border-forest-200 dark:border-forest-800">
          <Map class="w-3.5 h-3.5 text-forest-600 dark:text-forest-400" />
          <span>도서관 벽면 지도</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 dark:text-paper-100">
          발걸음이 닿은 장소들
        </h1>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-400 font-serif">
          벽면에 걸린 수도권 지도입니다. 마커를 클릭하면 앨범 정보가 열리고, 해당 장소의 책으로 이동할 수 있습니다. (총 {places.length}권의 앨범)
        </p>
      </header>

    <!-- 카카오맵 인터랙티브 뷰 -->
    <div class="mb-14">
      <MapView places={mapPlaces} />
    </div>

    <!-- 등록된 장소 카드 목록 -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-serif text-xl font-bold text-ink-900 dark:text-paper-100 flex items-center gap-2">
          <MapPin class="w-5 h-5 text-terracotta-500" />
          장소 목록 색인
        </h2>
        <span class="text-xs text-ink-400">가나다순 정렬</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {places.map((place) => (
          <article class="p-5 rounded-2xl bg-white dark:bg-night-900 border border-paper-200 dark:border-night-800 hover:border-terracotta-200 dark:hover:border-terracotta-700/50 shadow-sm transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-ink-400 mb-2">
                <span class="font-medium text-forest-700 dark:text-forest-100 bg-forest-50 dark:bg-night-800 px-2 py-0.5 rounded">
                  {place.data.type}
                </span>
                <span>{place.data.sido} {place.data.sigungu}</span>
              </div>

              <h3 class="font-serif text-lg font-bold text-ink-900 dark:text-paper-100 mb-2">
                <a href={baseUrl(`/places/${place.id}`)} class="hover:text-terracotta-600 dark:hover:text-terracotta-100 transition-colors">
                  {place.data.name}
                </a>
              </h3>

              {place.data.tips && (
                <p class="text-xs text-ink-600 dark:text-ink-400 leading-relaxed mb-4 line-clamp-2">
                  💡 {place.data.tips}
                </p>
              )}
            </div>

            <div class="pt-3 border-t border-paper-100 dark:border-night-800 flex flex-wrap gap-1">
              {place.data.facilities?.map((f) => (
                <Badge variant="muted" size="sm">
                  {f}
                </Badge>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>
</BaseLayout>
