---
import type { CollectionEntry } from 'astro:content';
import { getEntries } from 'astro:content';
import { baseUrl } from '@/lib/utils/url';
import { formatDateKorean } from '@/lib/utils/date';
import WalkCover from '@/components/walk/WalkCover.astro';
import Badge from '@/components/ui/Badge.astro';
import { MapPin, ArrowRight } from '@lucide/astro';

interface Props {
  walk: CollectionEntry<'walks'>;
}

const { walk } = Astro.props;
const { title, date, weather, mood, photoFolder, cover, places } = walk.data;

// 연결된 장소 정보 조회
const resolvedPlaces = await getEntries(places);

// 본문에서 첫 문단 또는 120자 발췌
const rawBody = walk.body || '';
const cleanBody = rawBody
  .replace(/#+\s+.*/g, '') // 헤더 제거
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // 마크다운 링크 텍스트만 유지
  .trim();
const firstParagraph = cleanBody.split('\n\n')[0] || '';
const excerpt = firstParagraph.length > 130 ? `${firstParagraph.slice(0, 130)}...` : firstParagraph;
---

<article class="group flex flex-col rounded-2xl border border-paper-200 dark:border-night-800 bg-white dark:bg-night-900/60 p-4 transition-all duration-300 hover:shadow-md hover:border-terracotta-200 dark:hover:border-terracotta-700/50 hover:-translate-y-0.5">
  <a href={baseUrl(`/walks/${walk.id}`)} class="block overflow-hidden rounded-xl">
    <WalkCover photoFolder={photoFolder} date={date} cover={cover} title={title} aspect="video" />
  </a>

  <div class="mt-4 flex flex-1 flex-col justify-between">
    <div>
      <!-- 날짜, 기분, 날씨 메타데이터 -->
      <div class="flex flex-wrap items-center gap-2 text-xs text-ink-500 dark:text-ink-400 mb-2">
        <time datetime={date} class="font-medium text-ink-600 dark:text-ink-300">
          {formatDateKorean(date)}
        </time>

        {mood && <Badge variant="accent">{mood}</Badge>}
        {weather && <Badge variant="default">{weather}</Badge>}
      </div>

      <!-- 제목 -->
      <h2 class="font-serif text-lg font-bold tracking-tight text-ink-900 dark:text-paper-100 group-hover:text-terracotta-600 dark:group-hover:text-terracotta-100 transition-colors line-clamp-2">
        <a href={baseUrl(`/walks/${walk.id}`)}>
          {title}
        </a>
      </h2>

      <!-- 본문 발췌 -->
      {excerpt && (
        <p class="mt-2 text-sm text-ink-600 dark:text-ink-400 line-clamp-2 leading-relaxed">
          {excerpt}
        </p>
      )}
    </div>

    <div class="mt-4 pt-3 border-t border-paper-100 dark:border-night-800/80 flex items-center justify-between gap-2">
      <!-- 방문한 장소 칩 -->
      <div class="flex flex-wrap items-center gap-1.5 overflow-hidden">
        {resolvedPlaces.map((place) => (
          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-forest-700 dark:text-forest-100 bg-forest-50 dark:bg-night-800 px-2 py-0.5 rounded-md">
            <MapPin class="w-3 h-3 text-forest-500" />
            {place.data.name}
          </span>
        ))}
      </div>

      <!-- 바로가기 링크 아이콘 -->
      <a
        href={baseUrl(`/walks/${walk.id}`)}
        class="inline-flex items-center text-xs font-semibold text-terracotta-600 dark:text-terracotta-100 group-hover:translate-x-0.5 transition-transform shrink-0"
        aria-label={`${title} 읽기`}
      >
        읽기
        <ArrowRight class="w-3.5 h-3.5 ml-1" />
      </a>
    </div>
  </div>
</article>
