---
import type { CollectionEntry } from 'astro:content';
import BookSpine from './BookSpine.astro';
import { BookOpen, MapPin, Flame, Clock } from '@lucide/astro';

interface Props {
  places: CollectionEntry<'places'>[];
  walks: CollectionEntry<'walks'>[];
}

const { places, walks } = Astro.props;

// 각 장소별 산책 기록 매핑 및 최신순 정렬
interface PlaceWithWalks {
  place: CollectionEntry<'places'>;
  walks: CollectionEntry<'walks'>[];
  latestDate: string;
  walkCount: number;
}

const placesWithWalks: PlaceWithWalks[] = places.map((place) => {
  const related = walks
    .filter((w) => w.data.places.some((p) => p.id === place.id))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return {
    place,
    walks: related,
    latestDate: related.length > 0 ? related[0].data.date : '1970-01-01',
    walkCount: related.length,
  };
});

// 시도별 분류
const seoulPlaces = placesWithWalks.filter((p) => p.place.data.sido === '서울특별시');
const gyeonggiPlaces = placesWithWalks.filter((p) => p.place.data.sido === '경기도');
const incheonPlaces = placesWithWalks.filter((p) => p.place.data.sido === '인천광역시');

// 정렬 목록: 최근 방문순
const recentSortedPlaces = [...placesWithWalks].sort(
  (a, b) => new Date(b.latestDate).getTime() - new Date(a.latestDate).getTime()
);

// 정렬 목록: 방문 많은 순
const countSortedPlaces = [...placesWithWalks].sort((a, b) => b.walkCount - a.walkCount);
---

<div class="bookshelf-system w-full" id="bookshelf-section">
  <!-- 서가 제어 바 (정렬 전환 탭) -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-wood-700 text-wood-100 flex items-center justify-center shadow-inner">
        <BookOpen class="w-4 h-4" />
      </div>
      <div>
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-ink-900 dark:text-paper-100">
          도서관 서가
        </h2>
        <p class="text-xs text-ink-500 dark:text-ink-400">
          책 한 권은 다녀온 장소 한 곳의 앨범입니다. 책을 골라 펼쳐보세요.
        </p>
      </div>
    </div>

    <!-- 정렬 탭 버튼 -->
    <div class="inline-flex p-1 rounded-xl bg-paper-200/80 dark:bg-night-900 border border-paper-300 dark:border-night-800 text-xs font-medium">
      <button
        type="button"
        class="shelf-tab-btn active px-3 py-1.5 rounded-lg transition-all text-terracotta-700 dark:text-terracotta-200 font-semibold bg-white dark:bg-night-800 shadow-sm flex items-center gap-1.5"
        data-view="region"
      >
        <MapPin class="w-3.5 h-3.5" />
        지역별 서가
      </button>

      <button
        type="button"
        class="shelf-tab-btn px-3 py-1.5 rounded-lg transition-all text-ink-600 dark:text-ink-400 hover:text-ink-900 dark:hover:text-paper-100 flex items-center gap-1.5"
        data-view="recent"
      >
        <Clock class="w-3.5 h-3.5" />
        최근 방문순
      </button>

      <button
        type="button"
        class="shelf-tab-btn px-3 py-1.5 rounded-lg transition-all text-ink-600 dark:text-ink-400 hover:text-ink-900 dark:hover:text-paper-100 flex items-center gap-1.5"
        data-view="count"
      >
        <Flame class="w-3.5 h-3.5" />
        두꺼운 책순
      </button>
    </div>
  </div>

  <!-- 1. 지역별 서가 뷰 (시·도별 3단 선반) -->
  <div id="shelf-view-region" class="shelf-view space-y-12">
    <!-- 서울 서가 칸 -->
    <div class="relative bg-paper-100/50 dark:bg-night-900/50 rounded-2xl p-4 sm:p-6 border border-paper-200/80 dark:border-night-800/80">
      <!-- 황동 명판 라벨 -->
      <div class="flex items-center justify-between mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-wood-800 text-amber-200 text-xs font-serif shadow-md border border-amber-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>서울 서가 ({seoulPlaces.length}권)</span>
        </div>
        <span class="text-[11px] text-ink-400">성동구 · 종로구 · 강북구 · 영등포구</span>
      </div>

      <!-- 책꽂이 열 (가로 스크롤 가능) -->
      <div class="relative overflow-x-auto hide-scrollbar pt-8 pb-0">
        <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max px-4">
          <!-- 좌측 북엔드 (황동 앤틱 장식) -->
          <div class="w-7 h-44 rounded-l-md bg-gradient-to-r from-amber-800 to-amber-700 border-l border-amber-400/40 shadow-md flex items-center justify-center shrink-0 opacity-85">
            <span class="writing-vertical text-[9px] font-serif text-amber-200 tracking-widest">소풍</span>
          </div>

          <!-- 책등 목록 -->
          {seoulPlaces.map(({ place, walks }) => (
            <BookSpine place={place} walks={walks} />
          ))}

          <!-- 우측 북엔드 (빈자리 감싸기) -->
          <div class="w-8 h-36 rounded-r-md bg-gradient-to-l from-amber-900 to-amber-800 border-r border-amber-400/30 shadow-md flex items-center justify-center shrink-0 opacity-80 ml-2">
            <span class="writing-vertical text-[9px] font-serif text-amber-300/80">SEOUL</span>
          </div>
        </div>

        <!-- 원목 선반 바닥 -->
        <div class="shelf-board h-5 w-full rounded-sm mt-0 shadow-lg"></div>
      </div>
    </div>

    <!-- 경기 서가 칸 -->
    <div class="relative bg-paper-100/50 dark:bg-night-900/50 rounded-2xl p-4 sm:p-6 border border-paper-200/80 dark:border-night-800/80">
      <div class="flex items-center justify-between mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-wood-800 text-amber-200 text-xs font-serif shadow-md border border-amber-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>경기 서가 ({gyeonggiPlaces.length}권)</span>
        </div>
        <span class="text-[11px] text-ink-400">수원시 영통구 · 팔달구 · 고양시 일산동구</span>
      </div>

      <div class="relative overflow-x-auto hide-scrollbar pt-8 pb-0">
        <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max px-4">
          <div class="w-7 h-44 rounded-l-md bg-gradient-to-r from-amber-800 to-amber-700 border-l border-amber-400/40 shadow-md flex items-center justify-center shrink-0 opacity-85">
            <span class="writing-vertical text-[9px] font-serif text-amber-200 tracking-widest">소풍</span>
          </div>

          {gyeonggiPlaces.map(({ place, walks }) => (
            <BookSpine place={place} walks={walks} />
          ))}

          <div class="w-8 h-36 rounded-r-md bg-gradient-to-l from-amber-900 to-amber-800 border-r border-amber-400/30 shadow-md flex items-center justify-center shrink-0 opacity-80 ml-2">
            <span class="writing-vertical text-[9px] font-serif text-amber-300/80">GYEONGGI</span>
          </div>
        </div>

        <div class="shelf-board h-5 w-full rounded-sm mt-0 shadow-lg"></div>
      </div>
    </div>

    <!-- 인천 서가 칸 -->
    <div class="relative bg-paper-100/50 dark:bg-night-900/50 rounded-2xl p-4 sm:p-6 border border-paper-200/80 dark:border-night-800/80">
      <div class="flex items-center justify-between mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-wood-800 text-amber-200 text-xs font-serif shadow-md border border-amber-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>인천 서가 ({incheonPlaces.length}권)</span>
        </div>
        <span class="text-[11px] text-ink-400">연수구 · 제물포구 (2026 개편 신설)</span>
      </div>

      <div class="relative overflow-x-auto hide-scrollbar pt-8 pb-0">
        <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max px-4">
          <div class="w-7 h-44 rounded-l-md bg-gradient-to-r from-amber-800 to-amber-700 border-l border-amber-400/40 shadow-md flex items-center justify-center shrink-0 opacity-85">
            <span class="writing-vertical text-[9px] font-serif text-amber-200 tracking-widest">소풍</span>
          </div>

          {incheonPlaces.map(({ place, walks }) => (
            <BookSpine place={place} walks={walks} />
          ))}

          <div class="w-8 h-36 rounded-r-md bg-gradient-to-l from-amber-900 to-amber-800 border-r border-amber-400/30 shadow-md flex items-center justify-center shrink-0 opacity-80 ml-2">
            <span class="writing-vertical text-[9px] font-serif text-amber-300/80">INCHEON</span>
          </div>
        </div>

        <div class="shelf-board h-5 w-full rounded-sm mt-0 shadow-lg"></div>
      </div>
    </div>
  </div>

  <!-- 2. 최근 방문순 단일 서가 뷰 -->
  <div id="shelf-view-recent" class="shelf-view hidden">
    <div class="relative bg-paper-100/50 dark:bg-night-900/50 rounded-2xl p-4 sm:p-6 border border-paper-200/80 dark:border-night-800/80">
      <div class="flex items-center justify-between mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-wood-800 text-amber-200 text-xs font-serif shadow-md border border-amber-500/30">
          <Clock class="w-3.5 h-3.5 text-amber-400" />
          <span>최근에 다녀온 순서대로 정렬된 서가 ({recentSortedPlaces.length}권)</span>
        </div>
        <span class="text-[11px] text-ink-400">최신 산책일 순</span>
      </div>

      <div class="relative overflow-x-auto hide-scrollbar pt-8 pb-0">
        <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max px-4">
          <div class="w-7 h-44 rounded-l-md bg-gradient-to-r from-amber-800 to-amber-700 border-l border-amber-400/40 shadow-md flex items-center justify-center shrink-0 opacity-85">
            <span class="writing-vertical text-[9px] font-serif text-amber-200 tracking-widest">최신</span>
          </div>

          {recentSortedPlaces.map(({ place, walks }) => (
            <BookSpine place={place} walks={walks} />
          ))}

          <div class="w-8 h-36 rounded-r-md bg-gradient-to-l from-amber-900 to-amber-800 border-r border-amber-400/30 shadow-md flex items-center justify-center shrink-0 opacity-80 ml-2">
            <span class="writing-vertical text-[9px] font-serif text-amber-300/80">PAST</span>
          </div>
        </div>

        <div class="shelf-board h-5 w-full rounded-sm mt-0 shadow-lg"></div>
      </div>
    </div>
  </div>

  <!-- 3. 방문 많은 순 (두꺼운 책) 뷰 -->
  <div id="shelf-view-count" class="shelf-view hidden">
    <div class="relative bg-paper-100/50 dark:bg-night-900/50 rounded-2xl p-4 sm:p-6 border border-paper-200/80 dark:border-night-800/80">
      <div class="flex items-center justify-between mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-wood-800 text-amber-200 text-xs font-serif shadow-md border border-amber-500/30">
          <Flame class="w-3.5 h-3.5 text-amber-400" />
          <span>발걸음이 잦았던 두꺼운 앨범순 ({countSortedPlaces.length}권)</span>
        </div>
        <span class="text-[11px] text-ink-400">누적 방문 횟수 순</span>
      </div>

      <div class="relative overflow-x-auto hide-scrollbar pt-8 pb-0">
        <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max px-4">
          <div class="w-7 h-44 rounded-l-md bg-gradient-to-r from-amber-800 to-amber-700 border-l border-amber-400/40 shadow-md flex items-center justify-center shrink-0 opacity-85">
            <span class="writing-vertical text-[9px] font-serif text-amber-200 tracking-widest">기록</span>
          </div>

          {countSortedPlaces.map(({ place, walks }) => (
            <BookSpine place={place} walks={walks} />
          ))}

          <div class="w-8 h-36 rounded-r-md bg-gradient-to-l from-amber-900 to-amber-800 border-r border-amber-400/30 shadow-md flex items-center justify-center shrink-0 opacity-80 ml-2">
            <span class="writing-vertical text-[9px] font-serif text-amber-300/80">TOME</span>
          </div>
        </div>

        <div class="shelf-board h-5 w-full rounded-sm mt-0 shadow-lg"></div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupShelfTabs() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.shelf-tab-btn');
    const views = document.querySelectorAll<HTMLDivElement>('.shelf-view');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetView = btn.getAttribute('data-view');
        if (!targetView) return;

        // 버튼 스타일 전환
        buttons.forEach((b) => {
          b.classList.remove('active', 'text-terracotta-700', 'dark:text-terracotta-200', 'font-semibold', 'bg-white', 'dark:bg-night-800', 'shadow-sm');
          b.classList.add('text-ink-600', 'dark:text-ink-400');
        });

        btn.classList.add('active', 'text-terracotta-700', 'dark:text-terracotta-200', 'font-semibold', 'bg-white', 'dark:bg-night-800', 'shadow-sm');
        btn.classList.remove('text-ink-600', 'dark:text-ink-400');

        // 뷰 전환
        views.forEach((view) => {
          view.classList.add('hidden');
        });

        const activeView = document.getElementById(`shelf-view-${targetView}`);
        activeView?.classList.remove('hidden');
      });
    });
  }

  setupShelfTabs();
  document.addEventListener('astro:after-swap', setupShelfTabs);
</script>
