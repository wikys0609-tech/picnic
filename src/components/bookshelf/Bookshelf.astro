---
import type { CollectionEntry } from 'astro:content';
import BookSpine from './BookSpine.astro';
import { baseUrl } from '@/lib/utils/url';
import { MapPin, Flame, Clock } from '@lucide/astro';

interface Props {
  places: CollectionEntry<'places'>[];
  walks: CollectionEntry<'walks'>[];
}

const { places, walks } = Astro.props;

interface PlaceWithWalks {
  place: CollectionEntry<'places'>;
  walks: CollectionEntry<'walks'>[];
  latestDate: string;
  walkCount: number;
}

const placesWithWalks: PlaceWithWalks[] = places.map((place) => {
  const related = walks
    .filter((w) => w.data.places.some((p) => p.id === place.id))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return {
    place,
    walks: related,
    latestDate: related.length > 0 ? related[0].data.date : '1970-01-01',
    walkCount: related.length,
  };
});

// 시도별 분류
const seoulPlaces = placesWithWalks.filter((p) => p.place.data.sido === '서울특별시');
const gyeonggiPlaces = placesWithWalks.filter((p) => p.place.data.sido === '경기도');
const incheonPlaces = placesWithWalks.filter((p) => p.place.data.sido === '인천광역시');

// 정렬 목록: 최근 방문순
const recentSortedPlaces = [...placesWithWalks].sort(
  (a, b) => new Date(b.latestDate).getTime() - new Date(a.latestDate).getTime()
);

// 정렬 목록: 방문 많은 순 (두꺼운 책)
const countSortedPlaces = [...placesWithWalks].sort((a, b) => b.walkCount - a.walkCount);

// 한 선반당 수용 권수 (데스크톱 기준 8~10권, 넘칠 경우 자동 다단 분할)
function chunkShelfTiers(items: PlaceWithWalks[], maxPerTier: number = 8): PlaceWithWalks[][] {
  const tiers: PlaceWithWalks[][] = [];
  for (let i = 0; i < items.length; i += maxPerTier) {
    tiers.push(items.slice(i, i + maxPerTier));
  }
  return tiers.length > 0 ? tiers : [[]];
}

const seoulTiers = chunkShelfTiers(seoulPlaces, 8);
const gyeonggiTiers = chunkShelfTiers(gyeonggiPlaces, 8);
const incheonTiers = chunkShelfTiers(incheonPlaces, 8);
const recentTiers = chunkShelfTiers(recentSortedPlaces, 8);
const countTiers = chunkShelfTiers(countSortedPlaces, 8);

const woodShelfDay = baseUrl('/assets/textures/oak-shelf-day.jpg');
const woodShelfNight = baseUrl('/assets/textures/oak-shelf-night.jpg');
---

<div
  class="bookshelf-section w-full relative z-10"
  id="bookshelf-container"
  style={`--bg-shelf-wood: url('${woodShelfDay}'); --bg-shelf-wood-dark: url('${woodShelfNight}');`}
>
  <!-- 상단 제어 바: 세련된 에디토리얼 글래스 패널 -->
  <div class="p-6 sm:p-8 rounded-2xl bg-white/80 dark:bg-stone-900/80 backdrop-blur-md border border-stone-200/90 dark:border-stone-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-xs"></span>
        <h2 class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-stone-900 dark:text-paper-100">
          산책 도서관 서가
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 font-serif">
        책 1권은 다녀온 장소 1곳의 앨범입니다. 책을 골라 펼쳐보세요. (총 {places.length}권의 앨범 꽂힘)
      </p>
    </div>

    <!-- 정렬 탭 버튼 -->
    <div class="inline-flex p-1.5 rounded-xl bg-stone-100/90 dark:bg-stone-800/90 border border-stone-200 dark:border-stone-700 text-xs font-serif font-medium shrink-0 shadow-xs">
      <button
        type="button"
        class="shelf-tab-btn active px-3.5 py-1.5 rounded-lg transition-all text-stone-900 dark:text-paper-100 font-bold bg-white dark:bg-stone-700 shadow-xs flex items-center gap-1.5"
        data-view="region"
      >
        <MapPin class="w-3.5 h-3.5 text-forest-600 dark:text-forest-400" />
        지역별 서가
      </button>

      <button
        type="button"
        class="shelf-tab-btn px-3.5 py-1.5 rounded-lg transition-all text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 flex items-center gap-1.5"
        data-view="recent"
      >
        <Clock class="w-3.5 h-3.5 text-amber-500" />
        최근 방문순
      </button>

      <button
        type="button"
        class="shelf-tab-btn px-3.5 py-1.5 rounded-lg transition-all text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 flex items-center gap-1.5"
        data-view="count"
      >
        <Flame class="w-3.5 h-3.5 text-terracotta-500" />
        두꺼운 앨범순
      </button>
    </div>
  </div>

  <!-- 1. 지역별 서가 뷰 (시·도별 다단 선반) -->
  <div id="shelf-view-region" class="shelf-view space-y-12">
    <!-- 서울 서가 -->
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <span class="w-2 h-4.5 bg-forest-600 rounded-xs shadow-xs"></span>
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            서울 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({seoulPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">성동구 · 종로구 · 강북구 · 영등포구</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <!-- 다단 선반 렌더링 -->
      <div class="space-y-12">
        {seoulTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative overflow-x-auto hide-scrollbar pt-4 pb-0">
            {seoulTiers.length > 1 && (
              <span class="absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max pl-1 pr-6">
              {tier.map(({ place, walks }) => (
                <BookSpine place={place} walks={walks} />
              ))}
              <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
            </div>
            <!-- 묵직한 24px 원목 선반 상판 -->
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- 경기 서가 -->
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <span class="w-2 h-4.5 bg-terracotta-600 rounded-xs shadow-xs"></span>
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            경기 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({gyeonggiPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">수원시 영통구 · 팔달구 · 고양시 일산동구</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="space-y-12">
        {gyeonggiTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative overflow-x-auto hide-scrollbar pt-4 pb-0">
            {gyeonggiTiers.length > 1 && (
              <span class="absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max pl-1 pr-6">
              {tier.map(({ place, walks }) => (
                <BookSpine place={place} walks={walks} />
              ))}
              <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- 인천 서가 -->
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <span class="w-2 h-4.5 bg-cyan-700 rounded-xs shadow-xs"></span>
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            인천 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({incheonPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">연수구 · 제물포구 (2026-07-01 출범 신설 구)</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="space-y-12">
        {incheonTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative overflow-x-auto hide-scrollbar pt-4 pb-0">
            {incheonTiers.length > 1 && (
              <span class="absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max pl-1 pr-6">
              {tier.map(({ place, walks }) => (
                <BookSpine place={place} walks={walks} />
              ))}
              <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 2. 최근 방문순 뷰 -->
  <div id="shelf-view-recent" class="shelf-view hidden">
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <Clock class="w-4 h-4 text-amber-500" />
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            최근 방문순 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({recentSortedPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">가장 최근에 다녀온 순서대로 꽂혀 있습니다</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="space-y-12">
        {recentTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative overflow-x-auto hide-scrollbar pt-4 pb-0">
            {recentTiers.length > 1 && (
              <span class="absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max pl-1 pr-6">
              {tier.map(({ place, walks }) => (
                <BookSpine place={place} walks={walks} />
              ))}
              <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 3. 두꺼운 책순 (방문 많은 순) 뷰 -->
  <div id="shelf-view-count" class="shelf-view hidden">
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <Flame class="w-4 h-4 text-terracotta-500" />
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            두꺼운 앨범순 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({countSortedPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">자주 찾아가 장(章)이 많이 쌓인 두꺼운 책부터 진열됩니다</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="space-y-12">
        {countTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative overflow-x-auto hide-scrollbar pt-4 pb-0">
            {countTiers.length > 1 && (
              <span class="absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="flex items-end justify-start gap-3 sm:gap-4 min-w-max pl-1 pr-6">
              {tier.map(({ place, walks }) => (
                <BookSpine place={place} walks={walks} />
              ))}
              <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function setupBookshelfControls() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.shelf-tab-btn');
    const viewContainers = document.querySelectorAll<HTMLDivElement>('.shelf-view');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetView = btn.dataset.view;
        if (!targetView) return;

        // 버튼 스타일 토글
        tabButtons.forEach((b) => {
          b.classList.remove('active', 'text-stone-900', 'dark:text-paper-100', 'font-bold', 'bg-white', 'dark:bg-stone-700', 'shadow-xs');
          b.classList.add('text-stone-600', 'dark:text-stone-400');
        });

        btn.classList.add('active', 'text-stone-900', 'dark:text-paper-100', 'font-bold', 'bg-white', 'dark:bg-stone-700', 'shadow-xs');
        btn.classList.remove('text-stone-600', 'dark:text-stone-400');

        // 뷰 컨테이너 토글
        viewContainers.forEach((container) => {
          container.classList.add('hidden');
        });

        const activeContainer = document.getElementById(`shelf-view-${targetView}`);
        activeContainer?.classList.remove('hidden');
      });
    });
  }

  function setupShelfHoverInfo() {
    const shelfCards = document.querySelectorAll<HTMLElement>('.shelf-card');

    shelfCards.forEach((card) => {
      const defaultInfo = card.querySelector<HTMLElement>('.default-info');
      const hoverInfo = card.querySelector<HTMLElement>('.hover-info');
      if (!defaultInfo || !hoverInfo) return;

      const books = card.querySelectorAll<HTMLElement>('.book-spine');
      let resetTimer: number | null = null;

      const clearTimer = () => {
        if (resetTimer !== null) {
          clearTimeout(resetTimer);
          resetTimer = null;
        }
      };

      const setHoverContent = (book: HTMLElement) => {
        clearTimer();
        const name = book.dataset.placeName || '';
        const type = book.dataset.placeType || '';
        const sigungu = book.dataset.placeSigungu || '';
        const walkCount = book.dataset.walkCount || '0';
        const latestDate = book.dataset.latestDate || '';
        const typeBg = book.dataset.typeBg || '#243C2E';

        const sigunguShort = sigungu.split(' ').pop() || '';

        hoverInfo.innerHTML = `
          <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold text-white tracking-wider shrink-0" style="background-color: ${typeBg}">
            ${type}
          </span>
          <strong class="font-serif font-bold text-stone-900 dark:text-paper-100 text-xs sm:text-sm shrink-0">
            ${name}
          </strong>
          <span class="text-stone-400 dark:text-stone-500 font-sans text-[11px] shrink-0">(${sigunguShort})</span>
          <span class="text-stone-300 dark:text-stone-700 hidden md:inline">·</span>
          <span class="font-sans text-stone-600 dark:text-stone-300 text-xs hidden md:inline">수록 산책 ${walkCount}편</span>
          ${latestDate ? `<span class="text-stone-300 dark:text-stone-700 hidden lg:inline">·</span><span class="font-sans text-stone-500 dark:text-stone-400 text-xs hidden lg:inline">최근 ${latestDate}</span>` : ''}
          <span class="text-forest-700 dark:text-forest-400 font-semibold font-serif text-xs ml-1 shrink-0 flex items-center">
            펼쳐보기 →
          </span>
        `;

        defaultInfo.classList.add('hidden');
        hoverInfo.classList.remove('hidden');
        hoverInfo.classList.add('flex');
      };

      const resetToDefault = () => {
        clearTimer();
        resetTimer = window.setTimeout(() => {
          hoverInfo.classList.add('hidden');
          hoverInfo.classList.remove('flex');
          defaultInfo.classList.remove('hidden');
        }, 120);
      };

      books.forEach((book) => {
        book.addEventListener('mouseenter', () => setHoverContent(book));
        book.addEventListener('focus', () => setHoverContent(book));
        book.addEventListener('mouseleave', resetToDefault);
        book.addEventListener('blur', resetToDefault);
      });

      card.addEventListener('mouseleave', resetToDefault);
    });
  }

  function initBookshelf() {
    setupBookshelfControls();
    setupShelfHoverInfo();
  }

  initBookshelf();
  document.addEventListener('astro:after-swap', initBookshelf);
</script>
