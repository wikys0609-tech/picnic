---
import type { CollectionEntry } from 'astro:content';
import BookSpine from './BookSpine.astro';
import { baseUrl } from '@/lib/utils/url';
import { MapPin, Flame, Clock } from '@lucide/astro';

interface Props {
  places: CollectionEntry<'places'>[];
  walks: CollectionEntry<'walks'>[];
}

const { places, walks } = Astro.props;

interface PlaceWithWalks {
  place: CollectionEntry<'places'>;
  walks: CollectionEntry<'walks'>[];
  latestDate: string;
  walkCount: number;
}

const placesWithWalks: PlaceWithWalks[] = places.map((place) => {
  const related = walks
    .filter((w) => w.data.places.some((p) => p.id === place.id))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return {
    place,
    walks: related,
    latestDate: related.length > 0 ? related[0].data.date : '1970-01-01',
    walkCount: related.length,
  };
});

// 시도별 분류
const seoulPlaces = placesWithWalks.filter((p) => p.place.data.sido === '서울특별시');
const gyeonggiPlaces = placesWithWalks.filter((p) => p.place.data.sido === '경기도');
const incheonPlaces = placesWithWalks.filter((p) => p.place.data.sido === '인천광역시');

// 정렬 목록: 최근 방문순
const recentSortedPlaces = [...placesWithWalks].sort(
  (a, b) => new Date(b.latestDate).getTime() - new Date(a.latestDate).getTime()
);

// 정렬 목록: 방문 많은 순 (두꺼운 책)
const countSortedPlaces = [...placesWithWalks].sort((a, b) => b.walkCount - a.walkCount);

// 한 선반당 수용 권수:
// 모바일(폭 <= 600px)에서는 1~2단 가로 스크롤 방식 (6권 이하 1단, 초과 시 2단 분할)
// 초기 SSR 시 모바일과 데스크톱 양쪽에서 레이아웃 이동(출렁임, CLS)을 완전히 방지
function chunkShelfTiers(items: PlaceWithWalks[]): PlaceWithWalks[][] {
  if (items.length <= 6) return [items];
  const mid = Math.ceil(items.length / 2);
  return [items.slice(0, mid), items.slice(mid)];
}

const seoulTiers = chunkShelfTiers(seoulPlaces);
const gyeonggiTiers = chunkShelfTiers(gyeonggiPlaces);
const incheonTiers = chunkShelfTiers(incheonPlaces);
const recentTiers = chunkShelfTiers(recentSortedPlaces);
const countTiers = chunkShelfTiers(countSortedPlaces);

const woodShelfDay = baseUrl('/assets/textures/oak-shelf-day.jpg');
const woodShelfNight = baseUrl('/assets/textures/oak-shelf-night.jpg');
---

<div
  class="bookshelf-section w-full relative z-10"
  id="bookshelf-container"
  style={`--bg-shelf-wood: url('${woodShelfDay}'); --bg-shelf-wood-dark: url('${woodShelfNight}');`}
>
  <!-- 상단 제어 바: 세련된 에디토리얼 글래스 패널 -->
  <div class="p-6 sm:p-8 rounded-2xl bg-white/80 dark:bg-stone-900/80 backdrop-blur-md border border-stone-200/90 dark:border-stone-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-xs"></span>
        <h2 class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-stone-900 dark:text-paper-100">
          산책 도서관 서가
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 font-serif">
        책 1권은 다녀온 장소 1곳의 앨범입니다. 책을 골라 펼쳐보세요. (총 {places.length}권의 앨범 꽂힘)
      </p>
    </div>

    <!-- 정렬 탭 버튼 -->
    <div class="inline-flex p-1.5 rounded-xl bg-stone-100/90 dark:bg-stone-800/90 border border-stone-200 dark:border-stone-700 text-xs font-serif font-medium shrink-0 shadow-xs">
      <button
        type="button"
        class="shelf-tab-btn active px-3.5 py-1.5 rounded-lg transition-all text-stone-900 dark:text-paper-100 font-bold bg-white dark:bg-stone-700 shadow-xs flex items-center gap-1.5"
        data-view="region"
      >
        <MapPin class="w-3.5 h-3.5 text-forest-600 dark:text-forest-400" />
        지역별 서가
      </button>

      <button
        type="button"
        class="shelf-tab-btn px-3.5 py-1.5 rounded-lg transition-all text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 flex items-center gap-1.5"
        data-view="recent"
      >
        <Clock class="w-3.5 h-3.5 text-amber-500" />
        최근 방문순
      </button>

      <button
        type="button"
        class="shelf-tab-btn px-3.5 py-1.5 rounded-lg transition-all text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 flex items-center gap-1.5"
        data-view="count"
      >
        <Flame class="w-3.5 h-3.5 text-terracotta-500" />
        두꺼운 앨범순
      </button>
    </div>
  </div>

  <!-- 1. 지역별 서가 뷰 (시·도별 다단 선반) -->
  <div id="shelf-view-region" class="shelf-view space-y-12">
    <!-- 서울 서가 -->
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <span class="w-2 h-4.5 bg-forest-600 rounded-xs shadow-xs"></span>
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            서울 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({seoulPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">성동구 · 종로구 · 강북구 · 영등포구</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <!-- 다단 선반 렌더링 -->
      <div class="shelf-tier-container space-y-12">
        {seoulTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative pt-5 pb-0">
            {seoulTiers.length > 1 && (
              <span class="shelf-tier-badge absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 dark:text-stone-500 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="shelf-tier-scroll-wrapper relative">
              <div class="shelf-scroll-hint-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#F6F1EA] dark:from-[#15110E] to-transparent sm:hidden opacity-0 transition-opacity duration-200"></div>

              <div class="shelf-tier-row flex items-end justify-start gap-3 sm:gap-4 pl-1 pr-10 sm:pr-6 overflow-x-auto sm:overflow-visible hide-scrollbar scroll-smooth">
                {tier.map(({ place, walks }) => (
                  <BookSpine place={place} walks={walks} />
                ))}
                <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
              </div>

              <div class="shelf-scroll-hint-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10 bg-gradient-to-l from-[#F6F1EA] dark:from-[#15110E] via-[#F6F1EA]/70 dark:via-[#15110E]/70 to-transparent sm:hidden transition-opacity duration-200 flex items-center justify-end pr-1">
                <span class="text-stone-400 dark:text-stone-500 text-xs font-serif font-bold">›</span>
              </div>
            </div>
            <!-- 묵직한 30px 원목 선반 상판 -->
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- 경기 서가 -->
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <span class="w-2 h-4.5 bg-terracotta-600 rounded-xs shadow-xs"></span>
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            경기 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({gyeonggiPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">수원시 영통구 · 팔달구 · 고양시 일산동구</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="shelf-tier-container space-y-12">
        {gyeonggiTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative pt-5 pb-0">
            {gyeonggiTiers.length > 1 && (
              <span class="shelf-tier-badge absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 dark:text-stone-500 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="shelf-tier-scroll-wrapper relative">
              <div class="shelf-scroll-hint-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#F6F1EA] dark:from-[#15110E] to-transparent sm:hidden opacity-0 transition-opacity duration-200"></div>

              <div class="shelf-tier-row flex items-end justify-start gap-3 sm:gap-4 pl-1 pr-10 sm:pr-6 overflow-x-auto sm:overflow-visible hide-scrollbar scroll-smooth">
                {tier.map(({ place, walks }) => (
                  <BookSpine place={place} walks={walks} />
                ))}
                <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
              </div>

              <div class="shelf-scroll-hint-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10 bg-gradient-to-l from-[#F6F1EA] dark:from-[#15110E] via-[#F6F1EA]/70 dark:via-[#15110E]/70 to-transparent sm:hidden transition-opacity duration-200 flex items-center justify-end pr-1">
                <span class="text-stone-400 dark:text-stone-500 text-xs font-serif font-bold">›</span>
              </div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- 인천 서가 -->
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <span class="w-2 h-4.5 bg-cyan-700 rounded-xs shadow-xs"></span>
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            인천 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({incheonPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">연수구 · 제물포구 · 서해구 (2026-07-01 출범 신설 구)</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="shelf-tier-container space-y-12">
        {incheonTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative pt-5 pb-0">
            {incheonTiers.length > 1 && (
              <span class="shelf-tier-badge absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 dark:text-stone-500 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="shelf-tier-scroll-wrapper relative">
              <div class="shelf-scroll-hint-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#F6F1EA] dark:from-[#15110E] to-transparent sm:hidden opacity-0 transition-opacity duration-200"></div>

              <div class="shelf-tier-row flex items-end justify-start gap-3 sm:gap-4 pl-1 pr-10 sm:pr-6 overflow-x-auto sm:overflow-visible hide-scrollbar scroll-smooth">
                {tier.map(({ place, walks }) => (
                  <BookSpine place={place} walks={walks} />
                ))}
                <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
              </div>

              <div class="shelf-scroll-hint-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10 bg-gradient-to-l from-[#F6F1EA] dark:from-[#15110E] via-[#F6F1EA]/70 dark:via-[#15110E]/70 to-transparent sm:hidden transition-opacity duration-200 flex items-center justify-end pr-1">
                <span class="text-stone-400 dark:text-stone-500 text-xs font-serif font-bold">›</span>
              </div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 2. 최근 방문순 뷰 -->
  <div id="shelf-view-recent" class="shelf-view hidden">
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <Clock class="w-4 h-4 text-amber-500" />
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            최근 방문순 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({recentSortedPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">가장 최근에 다녀온 순서대로 꽂혀 있습니다</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="shelf-tier-container space-y-12">
        {recentTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative pt-5 pb-0">
            {recentTiers.length > 1 && (
              <span class="shelf-tier-badge absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 dark:text-stone-500 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="shelf-tier-scroll-wrapper relative">
              <div class="shelf-scroll-hint-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#F6F1EA] dark:from-[#15110E] to-transparent sm:hidden opacity-0 transition-opacity duration-200"></div>

              <div class="shelf-tier-row flex items-end justify-start gap-3 sm:gap-4 pl-1 pr-10 sm:pr-6 overflow-x-auto sm:overflow-visible hide-scrollbar scroll-smooth">
                {tier.map(({ place, walks }) => (
                  <BookSpine place={place} walks={walks} />
                ))}
                <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
              </div>

              <div class="shelf-scroll-hint-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10 bg-gradient-to-l from-[#F6F1EA] dark:from-[#15110E] via-[#F6F1EA]/70 dark:via-[#15110E]/70 to-transparent sm:hidden transition-opacity duration-200 flex items-center justify-end pr-1">
                <span class="text-stone-400 dark:text-stone-500 text-xs font-serif font-bold">›</span>
              </div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 3. 두꺼운 책순 (방문 많은 순) 뷰 -->
  <div id="shelf-view-count" class="shelf-view hidden">
    <div class="library-bookcase shelf-card p-6 sm:p-8 rounded-2xl relative">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-stone-300/60 dark:border-stone-800 min-h-[36px]">
        <div class="flex items-center gap-2.5 shrink-0">
          <Flame class="w-4 h-4 text-terracotta-500" />
          <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900 dark:text-paper-100">
            두꺼운 앨범순 서가
          </h3>
          <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
            ({countSortedPlaces.length}권의 앨범)
          </span>
        </div>
        <div class="shelf-info-slot text-xs text-stone-500 dark:text-stone-400 font-sans text-right transition-all duration-200 flex items-center justify-end overflow-hidden">
          <span class="default-info hidden sm:inline truncate font-serif text-[11px] tracking-wide text-stone-500 dark:text-stone-400">자주 찾아가 장이 많이 쌓인 두꺼운 책부터 진열됩니다</span>
          <div class="hover-info hidden items-center gap-2 truncate"></div>
        </div>
      </div>

      <div class="shelf-tier-container space-y-12">
        {countTiers.map((tier, tierIndex) => (
          <div class="shelf-tier relative pt-5 pb-0">
            {countTiers.length > 1 && (
              <span class="shelf-tier-badge absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 dark:text-stone-500 tracking-wider">
                제 {tierIndex + 1} 단
              </span>
            )}
            <div class="shelf-tier-scroll-wrapper relative">
              <div class="shelf-scroll-hint-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#F6F1EA] dark:from-[#15110E] to-transparent sm:hidden opacity-0 transition-opacity duration-200"></div>

              <div class="shelf-tier-row flex items-end justify-start gap-3 sm:gap-4 pl-1 pr-10 sm:pr-6 overflow-x-auto sm:overflow-visible hide-scrollbar scroll-smooth">
                {tier.map(({ place, walks }) => (
                  <BookSpine place={place} walks={walks} />
                ))}
                <div class="shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block" title="원목 북엔드"></div>
              </div>

              <div class="shelf-scroll-hint-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10 bg-gradient-to-l from-[#F6F1EA] dark:from-[#15110E] via-[#F6F1EA]/70 dark:via-[#15110E]/70 to-transparent sm:hidden transition-opacity duration-200 flex items-center justify-end pr-1">
                <span class="text-stone-400 dark:text-stone-500 text-xs font-serif font-bold">›</span>
              </div>
            </div>
            <div class="wood-shelf-plank"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function updateScrollHints(row: HTMLElement) {
    const wrapper = row.closest('.shelf-tier-scroll-wrapper');
    if (!wrapper) return;
    const leftHint = wrapper.querySelector<HTMLElement>('.shelf-scroll-hint-left');
    const rightHint = wrapper.querySelector<HTMLElement>('.shelf-scroll-hint-right');

    const scrollLeft = row.scrollLeft;
    const maxScroll = row.scrollWidth - row.clientWidth;

    if (leftHint) {
      if (scrollLeft > 6) {
        leftHint.classList.remove('opacity-0');
        leftHint.classList.add('opacity-100');
      } else {
        leftHint.classList.remove('opacity-100');
        leftHint.classList.add('opacity-0');
      }
    }

    if (rightHint) {
      if (maxScroll - scrollLeft > 6) {
        rightHint.classList.remove('opacity-0');
        rightHint.classList.add('opacity-100');
      } else {
        rightHint.classList.remove('opacity-100');
        rightHint.classList.add('opacity-0');
      }
    }
  }

  function bindRowScroll(row: HTMLElement) {
    row.addEventListener('scroll', () => updateScrollHints(row), { passive: true });
    updateScrollHints(row);
  }

  function layoutShelfContainers() {
    const containers = document.querySelectorAll<HTMLElement>('.shelf-tier-container');
    const isMobile = window.innerWidth <= 600;

    containers.forEach((container) => {
      // 탭이 숨겨져 있어 폭이 0인 경우 패스 (활성화될 때 레이아웃 재호출)
      const containerWidth = container.clientWidth;
      if (containerWidth <= 0) return;

      // 현재 컨테이너 내부의 모든 책등 요소 수집
      const books = Array.from(container.querySelectorAll<HTMLElement>('.book-spine-wrapper'));
      if (books.length === 0) return;

      let tierGroups: HTMLElement[][] = [];

      if (isMobile) {
        // 모바일(폭 <= 600px): 한 지역당 1~2단 가로 스크롤 방식 (6권 이하 1단, 초과 시 2단 분할)
        if (books.length <= 6) {
          tierGroups = [books];
        } else {
          const mid = Math.ceil(books.length / 2);
          tierGroups = [books.slice(0, mid), books.slice(mid)];
        }
      } else {
        // PC·태블릿(폭 > 600px): 화면 폭에 맞춰 동적 다단 선반 분할
        const isSm = window.innerWidth >= 640;
        const gap = isSm ? 16 : 12;
        const bookendWidth = isSm ? 44 : 0;
        const paddingSafety = isSm ? 32 : 16;
        const maxRowWidth = Math.max(containerWidth - paddingSafety, 240);

        tierGroups = [[]];
        let currentRowWidth = 0;

        books.forEach((book) => {
          const bookWidth = book.offsetWidth || parseInt(book.style.width, 10) || 56;
          const neededWidth = (currentRowWidth === 0 ? 0 : gap) + bookWidth;

          if (currentRowWidth > 0 && currentRowWidth + neededWidth + bookendWidth > maxRowWidth) {
            tierGroups.push([book]);
            currentRowWidth = bookWidth;
          } else {
            tierGroups[tierGroups.length - 1].push(book);
            currentRowWidth += neededWidth;
          }
        });
      }

      // 만약 현재 DOM의 단 구조와 책 배치가 정확히 일치한다면 DOM 조작 생략 (레이아웃 이동 및 출렁임 방지)
      const existingTiers = Array.from(container.querySelectorAll<HTMLElement>('.shelf-tier'));
      let isMatching = existingTiers.length === tierGroups.length;
      if (isMatching) {
        for (let i = 0; i < tierGroups.length; i++) {
          const tierBooks = Array.from(existingTiers[i].querySelectorAll<HTMLElement>('.book-spine-wrapper'));
          if (tierBooks.length !== tierGroups[i].length) {
            isMatching = false;
            break;
          }
          for (let j = 0; j < tierBooks.length; j++) {
            if (tierBooks[j] !== tierGroups[i][j]) {
              isMatching = false;
              break;
            }
          }
          if (!isMatching) break;
        }
      }

      if (isMatching) {
        container.querySelectorAll<HTMLElement>('.shelf-tier-row').forEach(updateScrollHints);
        return;
      }

      // DOM 재구성: 기존 책 DOM 노드는 그대로 appendChild하여 이벤트 리스너와 터치 상태를 100% 보존
      const fragment = document.createDocumentFragment();

      tierGroups.forEach((groupBooks, index) => {
        const tierEl = document.createElement('div');
        tierEl.className = 'shelf-tier relative pt-5 pb-0';

        if (tierGroups.length > 1) {
          const badge = document.createElement('span');
          badge.className = 'shelf-tier-badge absolute top-0 left-1 text-[10px] font-serif font-medium text-stone-400 dark:text-stone-500 tracking-wider';
          badge.textContent = `제 ${index + 1} 단`;
          tierEl.appendChild(badge);
        }

        const scrollWrapper = document.createElement('div');
        scrollWrapper.className = 'shelf-tier-scroll-wrapper relative';

        const leftHint = document.createElement('div');
        leftHint.className = 'shelf-scroll-hint-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-[#F6F1EA] dark:from-[#15110E] to-transparent sm:hidden opacity-0 transition-opacity duration-200';
        scrollWrapper.appendChild(leftHint);

        const row = document.createElement('div');
        row.className = 'shelf-tier-row flex items-end justify-start gap-3 sm:gap-4 pl-1 pr-10 sm:pr-6 overflow-x-auto sm:overflow-visible hide-scrollbar scroll-smooth';

        groupBooks.forEach((b) => row.appendChild(b));

        // 원목 북엔드 (데스크톱 이상)
        const bookend = document.createElement('div');
        bookend.className = 'shelf-bookend shrink-0 mb-1 ml-3 hidden sm:block';
        bookend.title = '원목 북엔드';
        row.appendChild(bookend);

        scrollWrapper.appendChild(row);

        const rightHint = document.createElement('div');
        rightHint.className = 'shelf-scroll-hint-right pointer-events-none absolute right-0 top-0 bottom-0 w-12 z-10 bg-gradient-to-l from-[#F6F1EA] dark:from-[#15110E] via-[#F6F1EA]/70 dark:via-[#15110E]/70 to-transparent sm:hidden transition-opacity duration-200 flex items-center justify-end pr-1';
        rightHint.innerHTML = '<span class="text-stone-400 dark:text-stone-500 text-xs font-serif font-bold">›</span>';
        scrollWrapper.appendChild(rightHint);

        tierEl.appendChild(scrollWrapper);

        // 묵직한 30px 원목 선반 상판 (각 단마다 필수 유지)
        const plank = document.createElement('div');
        plank.className = 'wood-shelf-plank';
        tierEl.appendChild(plank);

        bindRowScroll(row);
        fragment.appendChild(tierEl);
      });

      container.innerHTML = '';
      container.appendChild(fragment);
    });
  }

  function setupBookshelfControls() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.shelf-tab-btn');
    const viewContainers = document.querySelectorAll<HTMLDivElement>('.shelf-view');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetView = btn.dataset.view;
        if (!targetView) return;

        // 버튼 스타일 토글
        tabButtons.forEach((b) => {
          b.classList.remove('active', 'text-stone-900', 'dark:text-paper-100', 'font-bold', 'bg-white', 'dark:bg-stone-700', 'shadow-xs');
          b.classList.add('text-stone-600', 'dark:text-stone-400');
        });

        btn.classList.add('active', 'text-stone-900', 'dark:text-paper-100', 'font-bold', 'bg-white', 'dark:bg-stone-700', 'shadow-xs');
        btn.classList.remove('text-stone-600', 'dark:text-stone-400');

        // 뷰 컨테이너 토글
        viewContainers.forEach((container) => {
          container.classList.add('hidden');
        });

        const activeContainer = document.getElementById(`shelf-view-${targetView}`);
        activeContainer?.classList.remove('hidden');

        // 활성화된 탭 컨테이너의 선반 레이아웃 동적 갱신
        requestAnimationFrame(() => {
          layoutShelfContainers();
        });
      });
    });
  }

  function setupShelfHoverInfo() {
    const shelfCards = document.querySelectorAll<HTMLElement>('.shelf-card');

    shelfCards.forEach((card) => {
      const defaultInfo = card.querySelector<HTMLElement>('.default-info');
      const hoverInfo = card.querySelector<HTMLElement>('.hover-info');
      if (!defaultInfo || !hoverInfo) return;

      const books = card.querySelectorAll<HTMLElement>('.book-spine');
      let resetTimer: number | null = null;

      const clearTimer = () => {
        if (resetTimer !== null) {
          clearTimeout(resetTimer);
          resetTimer = null;
        }
      };

      const setHoverContent = (book: HTMLElement) => {
        clearTimer();
        const name = book.dataset.placeName || '';
        const type = book.dataset.placeType || '';
        const sigungu = book.dataset.placeSigungu || '';
        const walkCount = book.dataset.walkCount || '0';
        const latestDate = book.dataset.latestDate || '';
        const typeBg = book.dataset.typeBg || '#243C2E';

        const sigunguShort = sigungu.split(' ').pop() || '';

        hoverInfo.innerHTML = `
          <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold text-white tracking-wider shrink-0" style="background-color: ${typeBg}">
            ${type}
          </span>
          <strong class="font-serif font-bold text-stone-900 dark:text-paper-100 text-xs sm:text-sm shrink-0">
            ${name}
          </strong>
          <span class="text-stone-400 dark:text-stone-500 font-sans text-[11px] shrink-0">(${sigunguShort})</span>
          <span class="text-stone-300 dark:text-stone-700 hidden md:inline">·</span>
          <span class="font-sans text-stone-600 dark:text-stone-300 text-xs hidden md:inline">수록 산책 ${walkCount}편</span>
          ${latestDate ? `<span class="text-stone-300 dark:text-stone-700 hidden lg:inline">·</span><span class="font-sans text-stone-500 dark:text-stone-400 text-xs hidden lg:inline">최근 ${latestDate}</span>` : ''}
          <span class="text-forest-700 dark:text-forest-400 font-semibold font-serif text-xs ml-1 shrink-0 flex items-center">
            펼쳐보기 →
          </span>
        `;

        defaultInfo.classList.add('hidden');
        hoverInfo.classList.remove('hidden');
        hoverInfo.classList.add('flex');
      };

      const resetToDefault = () => {
        clearTimer();
        resetTimer = window.setTimeout(() => {
          hoverInfo.classList.add('hidden');
          hoverInfo.classList.remove('flex');
          defaultInfo.classList.remove('hidden');
        }, 120);
      };

      let selectedBook: HTMLElement | null = null;
      const isTouch = window.matchMedia('(hover: none)').matches || 'ontouchstart' in window;

      books.forEach((book) => {
        book.addEventListener('mouseenter', () => {
          if (!isTouch) setHoverContent(book);
        });
        book.addEventListener('focus', () => setHoverContent(book));
        book.addEventListener('mouseleave', () => {
          if (!isTouch) resetToDefault();
        });
        book.addEventListener('blur', () => {
          if (!isTouch) resetToDefault();
        });

        // 모바일/터치 기기: 1차 탭 시 책 들림 & 상단 브리핑 표시, 2차 탭 시 이동
        book.addEventListener('click', (e) => {
          if (isTouch) {
            if (selectedBook !== book) {
              e.preventDefault();
              if (selectedBook) {
                selectedBook.classList.remove('-translate-y-5', 'ring-2', 'ring-amber-400');
              }
              selectedBook = book;
              book.classList.add('-translate-y-5', 'ring-2', 'ring-amber-400');
              setHoverContent(book);
              return;
            }
          }
        });
      });

      // 터치 환경에서 외부 클릭 시 선택 해제
      if (isTouch) {
        document.addEventListener('click', (e) => {
          if (selectedBook && !selectedBook.contains(e.target as Node)) {
            selectedBook.classList.remove('-translate-y-5', 'ring-2', 'ring-amber-400');
            selectedBook = null;
            resetToDefault();
          }
        });
      }

      card.addEventListener('mouseleave', () => {
        if (!isTouch) resetToDefault();
      });
    });
  }

  function initBookshelf() {
    setupBookshelfControls();
    setupShelfHoverInfo();

    // 초기 SSR 렌더링된 행들에 스크롤 힌트 이벤트 바인딩
    document.querySelectorAll<HTMLElement>('.shelf-tier-row').forEach(bindRowScroll);

    layoutShelfContainers();

    // 화면 폭 리사이즈 시 자동 다단 선반 재배치 (ResizeObserver)
    const shelfContainer = document.getElementById('bookshelf-container');
    if (shelfContainer) {
      let rAF: number | null = null;
      const observer = new ResizeObserver(() => {
        if (rAF !== null) cancelAnimationFrame(rAF);
        rAF = requestAnimationFrame(() => {
          layoutShelfContainers();
        });
      });
      observer.observe(shelfContainer);
    }
  }

  initBookshelf();
  document.addEventListener('astro:after-swap', initBookshelf);
</script>
