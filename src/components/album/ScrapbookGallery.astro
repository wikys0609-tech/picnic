---
import { baseUrl } from '@/lib/utils/url';
import { ZoomIn, Camera } from '@lucide/astro';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  photoFolder?: string;
  cover?: string;
  captions?: Record<string, string>;
  title: string;
}

const {
  photoFolder,
  cover = 'cover.webp',
  captions = {},
  title,
} = Astro.props;

// 사진 목록 구성
const rawList = cover ? [cover, ...Object.keys(captions).filter((k) => k !== cover)] : Object.keys(captions);

// 실제 로컬 디렉터리에 존재하는 사진 파일만 선별
const photoList = photoFolder
  ? rawList.filter((filename) => {
      try {
        const localPath = path.join(process.cwd(), 'public', 'photos', photoFolder, filename);
        return fs.existsSync(localPath);
      } catch (e) {
        return false;
      }
    })
  : [];
---

{photoFolder && (
  <div class="my-8 album-photo-gallery">
    {photoList.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
        {photoList.map((filename) => {
          const fullUrl = baseUrl(`/photos/${photoFolder}/${filename}`);
          const caption = captions[filename] || title;
          return (
            <div class="relative transition-transform duration-300 hover:scale-[1.015]">
              <!-- 정갈한 인화 사진 카드 (Fine Art Photo Print) -->
              <figure class="photo-print rounded-xs border border-stone-200/70 dark:border-stone-800">
                <button
                  type="button"
                  class="w-full text-left focus:outline-none focus:ring-2 focus:ring-amber-500/50 scrapbook-img-btn group relative block overflow-hidden rounded-xs bg-stone-100 dark:bg-stone-900"
                  data-img-src={fullUrl}
                  data-caption={caption}
                  aria-label={`${caption} 사진 원본 확대보기`}
                >
                  <div class="aspect-[4/3] w-full overflow-hidden">
                    <img
                      src={fullUrl}
                      alt={caption}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                  <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
                    <ZoomIn class="w-6 h-6 drop-shadow" />
                  </div>
                </button>

                <!-- 고품격 나눔명조 캡션 (Nanum Myeongjo) -->
                {captions[filename] && (
                  <figcaption class="mt-2.5 px-1 font-caption text-xs sm:text-sm text-stone-600 dark:text-stone-300 text-center leading-relaxed">
                    {captions[filename]}
                  </figcaption>
                )}
              </figure>
            </div>
          );
        })}
      </div>
    ) : (
      /* 사진 폴더는 있으나 아직 이미지가 동기화되지 않은 경우 */
      <div class="p-6 rounded-xl border border-dashed border-stone-300 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/40 text-center">
        <Camera class="w-5 h-5 mx-auto mb-2 text-stone-400 opacity-60" />
        <p class="font-serif text-sm text-stone-600 dark:text-stone-300">
          이 날의 사진들은 도서관 보관함에 잘 간직되어 있습니다.
        </p>
        <p class="text-xs text-stone-400 mt-1 font-sans">
          (Google Drive 사진 파이프라인 동기화 시 고화질로 꽂힙니다)
        </p>
      </div>
    )}
  </div>
)}
