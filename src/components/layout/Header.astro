---
import { baseUrl } from '@/lib/utils/url';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { Footprints, Map, Trophy, BookOpen } from '@lucide/astro';

const pathname = Astro.url.pathname;

const navItems = [
  { href: baseUrl('/'), label: '홈', icon: Footprints, exact: true },
  { href: baseUrl('/archive'), label: '산책 기록', icon: BookOpen },
  { href: baseUrl('/map'), label: '지도', icon: Map },
  { href: baseUrl('/conquest'), label: '정복 지도', icon: Trophy },
];

function isActive(itemHref: string, exact: boolean = false) {
  if (exact) {
    return pathname === itemHref || pathname === itemHref + '/';
  }
  return pathname.startsWith(itemHref);
}
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-paper-50/85 dark:bg-night-950/85 border-b border-paper-200 dark:border-night-800 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- 로고 / 사이트 제목 -->
    <a
      href={baseUrl('/')}
      class="group flex items-center gap-2.5 transition-transform hover:scale-[1.01]"
    >
      <div class="w-8 h-8 rounded-lg bg-terracotta-500 text-white flex items-center justify-center shadow-sm group-hover:bg-terracotta-600 transition-colors">
        <Footprints class="w-5 h-5" />
      </div>
      <div>
        <span class="font-serif text-lg font-bold tracking-tight text-ink-900 dark:text-paper-100 group-hover:text-terracotta-600 dark:group-hover:text-terracotta-100 transition-colors">
          소풍
        </span>
        <span class="hidden sm:inline-block ml-2 text-xs text-ink-500 dark:text-ink-400 font-sans">
          수도권 산책 일기
        </span>
      </div>
    </a>

    <!-- 네비게이션 & 테마 토글 -->
    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="flex items-center gap-1">
        {navItems.map((item) => {
          const active = isActive(item.href, item.exact);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${
                active
                  ? 'bg-paper-200/80 text-terracotta-600 dark:bg-night-800 dark:text-terracotta-100 font-semibold'
                  : 'text-ink-600 dark:text-ink-400 hover:text-ink-900 dark:hover:text-paper-100 hover:bg-paper-100 dark:hover:bg-night-900'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="h-4 w-px bg-paper-300 dark:bg-night-700 mx-1"></div>

      <ThemeToggle />
    </div>
  </div>
</header>
